  const showCaret = frame < 55 && Math.floor(frame / 8) % 2 === 0;

  const cursorX = Math.round(
    interpolate(frame, [20, 48], [260, 110], {
      extrapolateLeft: 'clamp',
      extrapolateRight: 'clamp',
    }),
  );
  const cursorY = Math.round(
    interpolate(frame, [20, 48], [160, 34], {
      extrapolateLeft: 'clamp',
      extrapolateRight: 'clamp',
    }),
  );
