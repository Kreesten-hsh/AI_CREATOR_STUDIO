        {
          id: 'test-screen',
          type: 'screenshot',
          src: 'https://images.unsplash.com/photo-2',
          alt: 'Capture de test pour LessonRenderer',
          caption: 'Légende capture',
          capturedAt: '2026-11',
        },
        {
          id: 'test-diag',
