              >
                <div className="flex items-center justify-between gap-1 w-full">
                  <span
                    className={`font-mono text-[10px] font-bold px-1.5 py-0.5 border border-ink rounded-brutal-tag ${
                      isActive ? 'bg-surface text-ink' : 'bg-surface text-ink'
