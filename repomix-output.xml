        {!useCustomFont ? (
          <div className="grid grid-cols-1 md:grid-cols-2 gap-3">
            {SAFE_FONTS.map((font) => {
              const isSelected = !useCustomFont && font.id === selectedFontId;
              const isHeadingReady = isFontAvailable(font.headingFont);

              return (
                <button
                  key={font.id}
