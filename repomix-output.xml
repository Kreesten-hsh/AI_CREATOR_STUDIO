<file path="public/demos/logo-preview.html">
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>AI CREATOR Studio : Kit Graphique Officiel (PNG HD &amp; SVG)</title>
  <link rel="icon" type="image/svg+xml" href="/logo-icon.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@1&family=JetBrains+Mono:wght@500;700&family=Plus+Jakarta+Sans:wght@500;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root {
      --cream: #FAF6F0;
      --red: #B63131;
      --pink: #E6A0A8;
      --pale-pink: #F7E0E2;
      --ink: #171313;
      --surface: #FFFDFC;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background-color: var(--cream);
      color: var(--ink);
      font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
      padding: 40px 20px;
      line-height: 1.5;
    }
    .container { max-width: 1080px; margin: 0 auto; }
    header {
      margin-bottom: 40px;
      padding-bottom: 24px;
      border-bottom: 3px solid var(--ink);
    }
    .badge {
      display: inline-block;
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      padding: 4px 10px;
      background: var(--ink);
      color: var(--cream);
      border-radius: 4px;
      margin-bottom: 12px;
    }
    h1 {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 900;
      font-size: 38px;
      line-height: 1.1;
      text-transform: uppercase;
      letter-spacing: -1.5px;
    }
    h1 span {
      font-family: 'Instrument Serif', Georgia, serif;
      font-style: italic;
      font-weight: 400;
      text-transform: lowercase;
      color: var(--red);
      font-size: 48px;
    }
    p.lead {
      margin-top: 10px;
      font-size: 16px;
      color: rgba(23, 19, 19, 0.85);
      max-width: 760px;
    }
    .grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 36px;
      margin-bottom: 48px;
    }
    .card {
      background: var(--surface);
      border: 3px solid var(--ink);
      border-radius: 12px;
      box-shadow: 6px 6px 0px var(--ink);
      padding: 28px;
      position: relative;
    }
    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 20px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .card-title {
      font-family: 'Plus Jakarta Sans', sans-serif;
      font-weight: 800;
      font-size: 20px;
      text-transform: uppercase;
    }
    .card-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      color: var(--red);
      font-weight: 700;
    }
    .preview-box {
      background: var(--cream);
      border: 2px dashed rgba(23, 19, 19, 0.3);
      border-radius: 8px;
      padding: 30px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 220px;
    }
    .preview-box img {
      max-width: 100%;
      height: auto;
      display: block;
    }
    .btn-row {
      display: flex;
      gap: 12px;
      margin-top: 20px;
      flex-wrap: wrap;
    }
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 18px;
      border: 2px solid var(--ink);
      border-radius: 6px;
      background: var(--surface);
      color: var(--ink);
      font-family: 'JetBrains Mono', monospace;
      font-size: 12px;
      font-weight: 700;
      text-transform: uppercase;
      text-decoration: none;
      box-shadow: 3px 3px 0px var(--ink);
      cursor: pointer;
      transition: all 0.15s ease;
    }
    .btn:hover {
      transform: translate(-2px, -2px);
      box-shadow: 5px 5px 0px var(--ink);
    }
    .btn-primary {
      background: var(--red);
      color: var(--surface);
    }
    .avatar-sim-row {
      display: flex;
      gap: 32px;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
    }
    .avatar-circle {
      width: 140px;
      height: 140px;
      border-radius: 50%;
      box-shadow: 4px 4px 0px var(--ink);
      overflow: hidden;
      border: 3px solid var(--ink);
    }
    .avatar-circle img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .avatar-meta {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      text-align: center;
      margin-top: 8px;
      font-weight: 700;
    }
    .platform-pills {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-top: 8px;
    }
    .platform-pill {
      font-family: 'JetBrains Mono', monospace;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      background: var(--pale-pink);
      color: var(--ink);
      border: 1px solid var(--ink);
      border-radius: 4px;
    }
  </style>
</head>
<body>
  <div class="container">
    <header>
      <div class="badge">KIT GRAPHIQUE OFFICIEL &bull; ULTRA-HD (RETINA READY)</div>
      <h1>AI CREATOR <span>studio</span> : Assets Graphiques Réseaux Sociaux</h1>
      <p class="lead">
        Fichiers officiels au format PNG Ultra-HD (1024&times;1024) et bannières optimisées pour Instagram, TikTok, Facebook, X (Twitter), YouTube et LinkedIn. Zéro compression floue, zéro encart carré, 100% net sur mobile.
      </p>
    </header>

    <div class="grid">
      <!-- 1. Master Avatar Universel (Variante A : Rouge Brique) -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">1. Avatar Universel Réseaux Sociaux (Variante A : Rouge Brique)</h2>
            <div class="platform-pills">
              <span class="platform-pill">&check; Instagram</span>
              <span class="platform-pill">&check; TikTok</span>
              <span class="platform-pill">&check; Facebook</span>
              <span class="platform-pill">&check; YouTube</span>
              <span class="platform-pill">&check; X / Twitter</span>
              <span class="platform-pill">&check; LinkedIn</span>
            </div>
          </div>
          <span class="card-meta">1024 &times; 1024 px &bull; PNG Master HD</span>
        </div>
        <div class="preview-box">
          <div class="avatar-sim-row">
            <div>
              <div class="avatar-circle">
                <img src="/avatar-universal-red.png" alt="Aperçu Instagram/TikTok">
              </div>
              <div class="avatar-meta">Rendu Instagram / TikTok</div>
            </div>
            <div>
              <div class="avatar-circle" style="width: 80px; height: 80px;">
                <img src="/avatar-universal-red.png" alt="Aperçu Facebook Mobile">
              </div>
              <div class="avatar-meta">Rendu Facebook Mobile</div>
            </div>
            <div>
              <div style="width: 140px; height: 140px; border: 3px solid var(--ink); border-radius: 12px; overflow: hidden; box-shadow: 4px 4px 0px var(--ink);">
                <img src="/avatar-universal-red.png" alt="Master carré 1024" style="width: 100%; height: 100%;">
              </div>
              <div class="avatar-meta">Fichier Master Carré</div>
            </div>
          </div>
        </div>
        <div class="btn-row">
          <a href="/avatar-universal-red.png" download="avatar-ai-creator-studio-red-1024.png" class="btn btn-primary">
            T&eacute;l&eacute;charger PNG 1024&times;1024 (Recommand&eacute;)
          </a>
          <a href="/avatar-universal-red.png" target="_blank" class="btn">
            Ouvrir en plein &eacute;cran
          </a>
        </div>
      </div>

      <!-- 2. Bannière de Couverture Facebook & Twitter -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">2. Bannière de Couverture Facebook &amp; Réseaux</h2>
            <p style="font-size: 13px; color: #666;">Page Facebook pro, profil d'entreprise, en-tête Twitter/X ou bannières de lancement</p>
          </div>
          <span class="card-meta">1640 &times; 624 px &bull; PNG Couverture HD</span>
        </div>
        <div class="preview-box">
          <img src="/banner-facebook-cover.png" alt="Bannière de couverture Facebook" style="max-height: 200px; width: auto; border: 2px solid var(--ink); border-radius: 6px;">
        </div>
        <div class="btn-row">
          <a href="/banner-facebook-cover.png" download="banniere-facebook-ai-creator-studio.png" class="btn btn-primary">
            T&eacute;l&eacute;charger la Couverture Facebook HD
          </a>
          <a href="/banner-facebook-cover.png" target="_blank" class="btn">
            Ouvrir en plein &eacute;cran
          </a>
        </div>
      </div>

      <!-- 3. Logo Horizontal Officiel HD -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">3. Logo Horizontal Officiel (PNG HD &amp; SVG)</h2>
            <p style="font-size: 13px; color: #666;">En-tête de site, publicités payantes, présentations slides, decks commerciaux</p>
          </div>
          <span class="card-meta">1800 &times; 400 px &bull; PNG &amp; SVG</span>
        </div>
        <div class="preview-box">
          <img src="/logo-horizontal.png" alt="Logo horizontal HD" style="max-height: 120px; width: auto;">
        </div>
        <div class="btn-row">
          <a href="/logo-horizontal.png" download="logo-horizontal-ai-creator-studio-hd.png" class="btn btn-primary">
            T&eacute;l&eacute;charger PNG Horizontal HD
          </a>
          <a href="/logo.svg" download="logo-horizontal-ai-creator-studio.svg" class="btn">
            T&eacute;l&eacute;charger SVG
          </a>
        </div>
      </div>

      <!-- 4. Avatar Alternatif Fond Crème -->
      <div class="card">
        <div class="card-header">
          <div>
            <h2 class="card-title">4. Avatar Alternatif (Variante B : Fond Cr&egrave;me Papier)</h2>
            <p style="font-size: 13px; color: #666;">Pour profils sur fond clair, site web ou documents de formation</p>
          </div>
          <span class="card-meta">1024 &times; 1024 px &bull; PNG Master HD</span>
        </div>
        <div class="preview-box">
          <div class="avatar-sim-row">
            <div class="avatar-circle">
              <img src="/avatar-universal-cream.png" alt="Avatar crème">
            </div>
            <div style="width: 140px; height: 140px; border: 3px solid var(--ink); border-radius: 12px; overflow: hidden; box-shadow: 4px 4px 0px var(--ink);">
              <img src="/avatar-universal-cream.png" alt="Fichier carré crème" style="width: 100%; height: 100%;">
            </div>
          </div>
        </div>
        <div class="btn-row">
          <a href="/avatar-universal-cream.png" download="avatar-ai-creator-studio-cream-1024.png" class="btn">
            T&eacute;l&eacute;charger PNG Cr&egrave;me 1024&times;1024
          </a>
        </div>
      </div>
    </div>
  </div>
</body>
</html>
