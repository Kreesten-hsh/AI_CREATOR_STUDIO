  <div class="chips" role="group" aria-labelledby="scLabel" id="chips"></div>

  <div class="grid">
    <div>
      <form id="form" novalidate onsubmit="return false">
        <section class="panel" aria-labelledby="h1s"><h2 id="h1s">01 · Cycle d'exploitation et BFR</h2><div id="s1"></div></section>
        <section class="panel" aria-labelledby="h2s"><h2 id="h2s">02 · Bilan synthétique et structure</h2><div id="s2"></div></section>
        <div class="actions">
          <button type="button" class="btn main" id="copy">Copier la synthèse</button>
          <button type="button" class="btn sec" id="clear">Tout effacer</button>
        </div>
        <p id="status" role="status" aria-live="polite"></p>
      </form>
    </div>

    <aside class="ticket" id="ticket" aria-label="Verdict de solvabilité">
      <div class="thead">
        <div class="kpi tn"><div class="k">Trésorerie nette</div><div class="v metric" id="tnV" aria-live="polite">—</div></div>
        <div class="kpi"><div class="k">Liquidité générale</div><div class="v metric" id="rV">—</div></div>
        <button type="button" class="tog" id="tog" aria-expanded="false" aria-controls="details">Détails ▲</button>
      </div>
      <div class="details" id="details">
        <h2 style="margin-top:.2rem">03 · Verdict</h2>
        <div class="row"><span>BFR</span><span class="rv" id="bfrV">—</span></div>
        <div class="row"><span>BFR en jours de CA</span><span class="rv" id="bjV">—</span></div>
        <div class="row"><span>Actif circulant</span><span class="rv" id="acV">—</span></div>
        <div class="row"><span>Passif circulant</span><span class="rv" id="pcV">—</span></div>
        <div id="gauge"></div>
        <div id="msgs"></div>
      </div>
    </aside>
  </div>
</main>
<footer>Fonctionne hors-ligne : aucune ressource externe, polices système. Outil indicatif : il ne remplace pas l'avis d'un expert-comptable.</footer>

<script>
(function(){
'use strict';
var CAP=99999999900; // 999 999 999 € en centimes
var FIELDS=[
 {s:'s1',id:'ca',l:"Chiffre d'affaires annuel HT",h:"Ventes hors taxes sur 12 mois."},
 {s:'s1',id:'sm',l:"Stocks moyens d'exploitation",h:"Moyenne des stocks sur l'exercice. Sert au calcul du BFR."},
 {s:'s1',id:'cr',l:"Créances clients",h:"Factures émises et non encore encaissées."},
 {s:'s1',id:'df',l:"Dettes fournisseurs",h:"Fournisseurs d'exploitation uniquement. Sert au calcul du BFR."},
 {s:'s2',id:'fr',l:"Fonds de roulement net global (FRNG)",h:"Ressources stables moins emplois durables. Peut être négatif.",neg:true},
 {s:'s2',id:'sb',l:"Stocks au bilan",h:"Stock de clôture, distinct des stocks moyens. Sert à l'actif circulant."},
 {s:'s2',id:'ta',l:"Trésorerie active",h:"Disponibilités bancaires, caisse et valeurs mobilières de placement."},
 {s:'s2',id:'dc',l:"Dettes à court terme",h:"Passif circulant total, distinct des dettes fournisseurs."}
];
var NOM={ca:360000,sm:30000,cr:45000,df:25000,fr:60000,sb:30000,ta:10000,dc:25000};
function mk(o){var r={};for(var k in NOM)r[k]=NOM[k];for(var j in o)r[j]=o[j];return r;}
var SCEN=[
 {n:"Nominal (PME en croissance)",v:NOM},
 {n:"CA nul (création)",v:mk({ca:0})},
 {n:"Aucune dette court terme",v:mk({dc:0})},
 {n:"BFR négatif",v:mk({sm:5000,cr:5000,df:30000})}
];
var NF=new Intl.NumberFormat('fr-FR');
function $(i){return document.getElementById(i);}
function fmt(c){var v=Math.round(c/100)||0;return NF.format(v).replace(/[\u202F\u00A0]/g,'\u00A0').replace('-','\u2212')+'\u00A0€';}
function fmtS(c){var t=fmt(c);return c>0?'+'+t:t;}

function parse(raw,neg){
  var str=String(raw).trim();
  if(str==='')return{ok:true,empty:true,c:0};
  var n=str.replace(/[\u00A0\u202F]/g,' ');
  if(/\d+\s+\d{1,2}\s+\d+/.test(n)||/\d+\s+\d{4,}/.test(n))return{ok:false,e:'Format de milliers invalide (exemple : 12 500).'};
  var c=n.replace(/\s/g,'');
  if((c.match(/[,.]/g)||[]).length>1)return{ok:false,e:'Plusieurs séparateurs décimaux : un seul est accepté.'};
  c=c.replace(',','.');
  if(!/^-?\d+(\.\d+)?$/.test(c))return{ok:false,e:'Saisissez uniquement des chiffres (exemple : 12 500).'};
  if(c.charAt(0)==='-'&&!neg)return{ok:false,e:'Ce montant ne peut pas être négatif.'};
  var neg2=c.charAt(0)==='-';if(neg2)c=c.slice(1);
  var p=c.split('.'),d=p[1]||'';
  if(d.length>2)return{ok:false,e:'Deux décimales maximum.'};
  while(d.length<2)d+='0';
  var cents=Number(p[0]+d);
  if(!Number.isSafeInteger(cents)||cents>CAP)return{ok:false,e:'Montant supérieur au plafond de 999 999 999 €.'};
  return{ok:true,empty:false,c:neg2?-cents:cents};
}

function build(){
  FIELDS.forEach(function(f){
    var d=document.createElement('div');d.className='field';
    d.innerHTML='<label for="i_'+f.id+'">'+f.l+'</label><div class="iwu" id="w_'+f.id+'"><input id="i_'+f.id+'" type="text" inputmode="decimal" autocomplete="off" placeholder="0" aria-describedby="h_'+f.id+' e_'+f.id+'"><span class="u" aria-hidden="true">€</span></div><p class="help" id="h_'+f.id+'">'+f.h+'</p><p class="err" id="e_'+f.id+'" hidden></p>';
    $(f.s).appendChild(d);
    $('i_'+f.id).addEventListener('input',calc);
  });
  SCEN.forEach(function(s,i){
    var b=document.createElement('button');b.type='button';b.className='chip';b.textContent=s.n;b.setAttribute('aria-pressed','false');
    b.addEventListener('click',function(){load(i);});$('chips').appendChild(b);
  });
}
function setVals(v){FIELDS.forEach(function(f){$('i_'+f.id).value=(v&&v[f.id]!==undefined)?NF.format(v[f.id]).replace(/[\u202F\u00A0]/g,' '):'';});}
function load(i){
  setVals(SCEN[i].v);
  var cs=$('chips').children;for(var k=0;k<cs.length;k++)cs[k].setAttribute('aria-pressed',k===i?'true':'false');
  $('status').textContent='Scénario chargé : '+SCEN[i].n+'.';calc(null,true);
}
function unpress(){var cs=$('chips').children;for(var k=0;k<cs.length;k++)cs[k].setAttribute('aria-pressed','false');}

function msg(tag,txt,s){return '<div class="msg" data-s="'+s+'" role="note"><b>'+tag+'</b>'+txt+'</div>';}
function setV(id,t,s){var e=$(id);e.textContent=t;if(s)e.setAttribute('data-s',s);else e.removeAttribute('data-s');}
var last=null;

function calc(ev,keep){
  if(ev&&!keep)unpress();
  var v={},bad=0;
  FIELDS.forEach(function(f){
    var r=parse($('i_'+f.id).value,f.neg),w=$('w_'+f.id),e=$('e_'+f.id),inp=$('i_'+f.id);
    if(!r.ok){bad++;w.classList.add('bad');inp.setAttribute('aria-invalid','true');e.textContent=r.e;e.hidden=false;}
    else{w.classList.remove('bad');inp.removeAttribute('aria-invalid');e.hidden=true;e.textContent='';v[f.id]=r.c;}
  });
  if(bad){
    last=null;
    ['tnV','rV','bfrV','bjV','acV','pcV'].forEach(function(i){setV(i,'—');});
    $('gauge').innerHTML='';
    $('msgs').innerHTML=msg('Saisie à corriger',bad+' champ'+(bad>1?'s':'')+' à corriger : les calculs sont suspendus tant que les erreurs signalées ne sont pas résolues.','warn');
    return;
  }
  var bfr=v.sm+v.cr-v.df,tn=v.fr-bfr,ac=v.sb+v.cr+v.ta,pc=v.dc;
  var out=[];
  setV('bfrV',fmt(bfr));setV('tnV',fmtS(tn),tn>0?'ok':tn<0?'tension':'neutral');
  setV('acV',fmt(ac));setV('pcV',fmt(pc));
  // BFR en jours
  var bj=null,bjT;
  if(v.ca===0){bjT='Non calculable';setV('bjV','Non calculable','warn');out.push(msg('BFR en jours','Calcul impossible : le chiffre d\'affaires annuel HT est nul','warn'));}
  else{var j=bfr*360/v.ca;bj=j;bjT=(Number.isInteger(j)?String(j):j.toFixed(1).replace('.',','))+' jours';setV('bjV',bjT.replace('-','\u2212'));}
  // Ratio
  var rT,rc=null;
  if(pc===0){rT='Indéterminé';setV('rV','Indéterminé','warn');out.push(msg('Ratio de liquidité générale','Indéterminé : passif circulant nul','warn'));}
  else{
    rc=(Math.round(ac*100/pc)/100).toFixed(2).replace('.',',');rT=rc;
    var cls=ac*2>=pc*3?'ok':ac>=pc?'warn':'tension';
    setV('rV',rc,cls);
    var t=cls==='ok'?'▲ Excellente couverture du passif à court terme (1,50 et plus).':cls==='warn'?'● Couverture correcte mais équilibre sensible (de 1,00 à moins de 1,50).':'▼ Risque d\'insolvabilité à court terme : les dettes échues dépassent les avoirs réalisables et disponibles (moins de 1,00).';
    out.push(msg('Ratio de liquidité générale',t,cls));
  }
  // Trésorerie nette
  out.unshift(msg('Trésorerie nette',tn>0?'▲ Situation saine : le FRNG finance l\'intégralité du BFR et dégage un excédent de trésorerie disponible.':tn<0?'▼ Tension de trésorerie : le BFR excède les ressources stables, ce qui nécessite des crédits de trésorerie bancaires à court terme.':'● Équilibre parfait : le FRNG finance exactement le BFR.',tn>0?'ok':tn<0?'tension':'warn'));
  // BFR négatif
  if(bfr<0)out.push(msg('BFR','Ressource en fonds de roulement : l\'exploitation génère un excédent de financement de '+fmt(-bfr),'ok'));
  // Avertissement non bloquant
  if(v.df>v.dc)out.push(msg('À vérifier','Les dettes fournisseurs dépassent les dettes à court terme. Or les dettes à court terme incluent normalement les dettes fournisseurs. Vérifiez vos saisies (calcul maintenu).','warn'));
  $('msgs').innerHTML=out.join('');
  $('gauge').innerHTML=gauge(v.fr,bfr);
  last={v:v,bfr:bfr,tn:tn,ac:ac,pc:pc,bjT:bjT,rT:rT,bfrNeg:bfr<0};
}

function gauge(fr,bfr){
  var W=300,pad=14,mn=Math.min(0,fr,bfr),mx=Math.max(0,fr,bfr),span=mx-mn;
  function x(c){return span===0?W/2+pad:pad+(c-mn)/span*W;}
  var z=x(0);
  function bar(y,c,col,lab){
    var x1=Math.min(z,x(c)),w=Math.max(Math.abs(x(c)-z),2);
    return '<text class="gt" x="'+pad+'" y="'+y+'">'+lab+' : '+fmt(c)+'</text><rect x="'+x1+'" y="'+(y+6)+'" width="'+w+'" height="18" fill="'+col+'" rx="2"/>';
  }
  var d='FRNG '+fmt(fr)+', BFR '+fmt(bfr)+'.';
  return '<svg role="img" aria-labelledby="gT gD" viewBox="0 0 '+(W+2*pad)+' 100"><title id="gT">Jauge FRNG contre BFR</title><desc id="gD">'+d+'</desc>'+
    bar(14,fr,'#5FD39A','FRNG')+bar(56,bfr,'#F2B134','BFR')+
    '<line class="gz" x1="'+z+'" y1="4" x2="'+z+'" y2="90"/><text class="gt" x="'+Math.min(Math.max(z,22),W+pad-22)+'" y="99" text-anchor="middle">0 €</text></svg>';
}

function synth(){
  if(!last)return null;var L=last,v=L.v;
  var s=['SYNTHÈSE TRÉSORERIE & SANTÉ FINANCIÈRE PME (montants HT)',
   'CA annuel : '+fmt(v.ca)+' | Stocks moyens : '+fmt(v.sm)+' | Créances : '+fmt(v.cr)+' | Dettes fournisseurs : '+fmt(v.df),
   'FRNG : '+fmt(v.fr)+' | Stocks au bilan : '+fmt(v.sb)+' | Trésorerie active : '+fmt(v.ta)+' | Dettes court terme : '+fmt(v.dc),
   '',
   'BFR : '+fmt(L.bfr)+(L.bfrNeg?' (ressource en fonds de roulement)':''),
   'BFR en jours de CA : '+(v.ca===0?'calcul impossible, CA nul':L.bjT),
   'Trésorerie nette : '+fmtS(L.tn),
   'Actif circulant : '+fmt(L.ac)+' | Passif circulant : '+fmt(L.pc),
   'Ratio de liquidité générale : '+(L.pc===0?'indéterminé, passif circulant nul':L.rT)];
  return s.join('\n');
}
function copy(){
  var t=synth(),st=$('status');
  if(!t){st.textContent='Corrigez d\'abord les champs signalés : aucune synthèse à copier.';return;}
  function ok(){st.textContent='Synthèse copiée dans le presse-papiers.';}
  function fb(){var a=document.createElement('textarea');a.value=t;a.setAttribute('readonly','');a.style.position='fixed';a.style.opacity='0';document.body.appendChild(a);a.select();try{document.execCommand('copy')?ok():st.textContent='Copie impossible : sélectionnez le texte manuellement.';}catch(e){st.textContent='Copie impossible dans ce navigateur.';}document.body.removeChild(a);}
  if(navigator.clipboard&&window.isSecureContext)navigator.clipboard.writeText(t).then(ok,fb);else fb();
}
$('copy');
build();
$('copy').addEventListener('click',copy);
$('clear').addEventListener('click',function(){
  if(window.confirm('Effacer toutes les saisies ?')){setVals(null);unpress();$('status').textContent='Toutes les saisies ont été effacées.';calc(null,true);}
});
$('tog').addEventListener('click',function(){
  var t=$('ticket'),o=t.classList.toggle('open');
  this.setAttribute('aria-expanded',o?'true':'false');this.textContent=o?'Détails ▼':'Détails ▲';
});
load(0);
})();
</script>
</body>
</html>
