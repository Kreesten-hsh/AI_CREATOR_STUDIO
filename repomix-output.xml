      });
      expect(result.current.state.activeRoute).toMatchObject({
        courseId: 'module-02',
        dayNumber: 6,
      });

      act(() => {
        result.current.navigateToDay(7);
      });
      expect(result.current.state.activeRoute).toMatchObject({
        courseId: 'module-03',
        dayNumber: 7,
      });
