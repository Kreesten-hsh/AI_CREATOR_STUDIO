    :root {
      --red: #B63131;
      --cream: #FAF6F0;
      --pale-pink: #F7E0E2;
      --dusty-pink: #E6A0A8;
      --surface: #FFFDFC;
      --yellow: #FFD65C;
      --ink: #171313;
      --calc-blue: #2563EB;
      --calc-line: #93C5FD;
      --calc-cream: #FDF0E0;

      --font-serif: 'Instrument Serif', Georgia, serif;
      --font-hand: 'Gaegu', 'Caveat', cursive, 'Noto Color Emoji';
      --font-mono: 'JetBrains Mono', monospace;
      --font-sans: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif, 'Noto Color Emoji';
      --font-display: 'Archivo Black', 'Plus Jakarta Sans', sans-serif;
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      background: #E9E2D8;
      color: var(--ink);
      font-family: var(--font-sans);
      font-size: 15px;
      line-height: 1.6;
      padding: 28px 12px 64px;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
    }

    html.is-export body {
      background: var(--cream);
      padding: 0;
      margin: 0;
    }

    /* Barre flottante de previsualisation (masquee automatiquement lors de l'export ?export=1) */
    #preview-toolbar {
      position: fixed;
      top: 16px;
      right: 16px;
      z-index: 9999;
      background: var(--surface);
      border: 2px solid var(--ink);
      border-radius: 10px;
      box-shadow: 4px 4px 0 var(--ink);
      padding: 10px 12px;
      width: 248px;
      font-family: var(--font-sans);
    }

    html.is-export #preview-toolbar {
      display: none !important;
    }

    .toolbar-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      margin-bottom: 8px;
    }

    .toolbar-title {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--red);
    }

    .toolbar-actions {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .toolbar-btn {
      display: inline-flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      min-height: 36px;
      padding: 6px 10px;
      border: 1.5px solid var(--ink);
      border-radius: 6px;
      background: var(--cream);
      color: var(--ink);
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 700;
      text-decoration: none;
      cursor: pointer;
      transition: transform 0.12s ease, background-color 0.12s ease;
    }

    .toolbar-btn:hover {
      background: var(--pale-pink);
      transform: translate(-1px, -1px);
    }

    .toolbar-btn--primary {
      background: var(--red);
      color: var(--surface);
    }

    .toolbar-btn--primary:hover {
      background: #9E2727;
      color: var(--surface);
    }

    .toolbar-slices {
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed rgba(23, 19, 19, 0.25);
      display: none;
      flex-direction: column;
      gap: 4px;
      max-height: 280px;
      overflow-y: auto;
    }

    .toolbar-slices.is-open {
      display: flex;
    }

    .toolbar-slice-link {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 5px 8px;
      border-radius: 5px;
      border: 1px solid rgba(23, 19, 19, 0.2);
      background: var(--surface);
      color: var(--ink);
      text-decoration: none;
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 700;
    }

    .toolbar-slice-link:hover {
      background: var(--pale-pink);
      border-color: var(--ink);
    }

    /* Colonne principale de vente 600px exacts */
    #sales-column {
      width: 600px;
      max-width: 600px;
      margin: 0 auto;
      overflow: hidden;
      background: var(--cream);
      box-shadow: 0 20px 60px rgba(23, 19, 19, 0.14);
    }

    html.is-export #sales-column {
      margin: 0;
      box-shadow: none;
    }

    #sales-column > section[data-slice] {
      width: 600px;
      position: relative;
      display: block;
      overflow: hidden;
    }

    /* Repere visuel optionnel en mode decoupe navigateur */
    #sales-column.show-slice-guides > section[data-slice] {
      outline: 2px dashed rgba(23, 19, 19, 0.45);
      outline-offset: -2px;
      margin-bottom: 14px;
    }

    #sales-column.show-slice-guides > section[data-slice]::before {
      content: "TRANCHE " attr(data-slice);
      position: absolute;
      top: 8px;
      left: 8px;
      z-index: 20;
      background: var(--ink);
      color: var(--cream);
      font-family: var(--font-mono);
      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.08em;
      padding: 2px 7px;
      border-radius: 4px;
    }

    /* Typographies & helpers transverses */
    .eyebrow {
      font-family: var(--font-mono);
      font-size: 10.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
      line-height: 1.45;
    }

    .double-underline {
      position: relative;
      display: inline-block;
      white-space: nowrap;
    }

    .double-underline-svg {
      position: absolute;
      left: -2px;
      bottom: -6px;
      width: calc(100% + 4px);
      height: 10px;
      pointer-events: none;
      overflow: visible;
    }

    .hand-underline {
      position: relative;
      display: inline-block;
    }

    .hand-underline-svg {
      position: absolute;
      left: 0;
      bottom: -5px;
      width: 100%;
      height: 8px;
      pointer-events: none;
      overflow: visible;
    }

    .pink-highlight {
      background: var(--pale-pink);
      padding: 1px 6px;
      font-weight: 700;
      border-radius: 3px;
    }

    .hl-yellow {
      background: var(--yellow);
      color: var(--ink);
      padding: 1px 4px;
      border-radius: 3px;
      font-weight: 700;
    }

    /* ===================================================================== */
    /* TRANCHE 01 : HERO ROUGE BRIQUE + DAMIER                               */
    /* ===================================================================== */
    .slice-01 {
      background: var(--red);
      color: var(--cream);
      padding: 44px 36px 40px;
    }

    .slice-01-top {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 24px;
    }

    .slice-01-title {
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 52px;
      line-height: 1.03;
      color: var(--cream);
      letter-spacing: -0.01em;
    }

    .slice-01-copy {
      margin-top: 20px;
      font-size: 15.5px;
      line-height: 1.56;
      color: rgba(250, 246, 240, 0.94);
    }

    .slice-01-copy p + p {
      margin-top: 12px;
    }

    .slice-01-rule {
      border: 0;
      border-top: 1px solid rgba(250, 246, 240, 0.35);
      margin: 24px 0 22px;
    }

    .slice-01-closing {
      font-family: var(--font-serif);
      font-style: italic;
      font-weight: 400;
      font-size: 28px;
      line-height: 1.24;
      color: var(--cream);
    }

    .slice-01-subclosing {
      display: block;
      margin-top: 8px;
      font-family: var(--font-sans);
      font-style: normal;
      font-size: 13.5px;
      opacity: 0.92;
      color: var(--cream);
    }

    /* ===================================================================== */
    /* TRANCHE 02 : MOCKUP COMPOSITE MACBOOK + IPHONE                        */
    /* ===================================================================== */
    .slice-02 {
      background: var(--cream);
      color: var(--ink);
      padding: 44px 32px 40px;
      text-align: center;
    }

    .slice-02 .eyebrow {
      color: rgba(23, 19, 19, 0.78);
    }

    .slice-02-title {
      font-family: var(--font-serif);
      font-weight: 400;
      font-size: 34px;
      line-height: 1.12;
      color: var(--ink);
      margin-top: 10px;
    }

    .slice-02-hand {
      font-family: var(--font-hand);
      font-weight: 700;
      font-size: 28px;
      line-height: 1.15;
      color: var(--red);
      margin-top: 6px;
    }

    .mockup-stage {
      position: relative;
      margin-top: 28px;
      padding-bottom: 18px;
    }

    .macbook-wrap {
      width: 406px;
      margin: 0 auto 0 6px;
      position: relative;
      z-index: 1;
    }

    .macbook-lid {
      background: #1B1717;
      border-radius: 13px 13px 3px 3px;
      padding: 8px 8px 6px;
      box-shadow: 0 14px 32px rgba(23, 19, 19, 0.16);
      position: relative;
    }

    .macbook-notch {
      position: absolute;
      top: 8px;
      left: 50%;
      transform: translateX(-50%);
      width: 46px;
      height: 7px;
      background: #1B1717;
      border-radius: 0 0 5px 5px;
      z-index: 5;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .macbook-cam {
      width: 3px;
      height: 3px;
      border-radius: 50%;
      background: #463E3E;
    }

    .macbook-screen {
      background: var(--cream);
      border-radius: 6px;
      overflow: hidden;
      text-align: left;
      border: 1px solid #312B2B;
    }

    .macbook-base {
      width: 430px;
      margin-left: -12px;
      height: 11px;
      background: linear-gradient(180deg, #DBD5CE 0%, #B7B0A8 100%);
      border-radius: 0 0 9px 9px;
      border-top: 1px solid #8E867E;
      position: relative;
    }

    .macbook-thumb {
      width: 66px;
      height: 4px;
      background: #9B938B;
      border-radius: 0 0 4px 4px;
      margin: 0 auto;
    }

    /* Interface fidele de la Page d'Accueil d'AI CREATOR Studio */
    .studio-topbar {
      background: var(--pale-pink);
      border-bottom: 1.5px solid var(--ink);
