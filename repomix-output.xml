    fireEvent.click(item1);
    fireEvent.click(item2);

    expect(screen.getByText('2/8 TERMINÉES (25%)')).toBeInTheDocument();

    unmount();

    // Remontage
    render(
      <ProgressProvider>
        <CourseWorkspaceRouter />
      </ProgressProvider>
