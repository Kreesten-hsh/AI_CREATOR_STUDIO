import { CheckCircle2, HelpCircle, RotateCcw, XCircle } from 'lucide-react';
import type { QuizBlock } from '../../types/course';
import { useProgress } from '../../hooks/useProgress';

export function QuizWidget({ block }: { block: QuizBlock }) {
  const { state, saveQuizAttempt } = useProgress();
  const savedAttempt = state.quizStates[block.id] ?? {
    answers: {},
    submitted: false,
    score: 0,
    total: block.questions.length,
  };

  const handleSelectOption = (questionId: string, optionIdx: number) => {
    const nextAnswers = {
      ...savedAttempt.answers,
      [questionId]: optionIdx,
    };

    let nextScore = 0;
    for (const q of block.questions) {
      if (nextAnswers[q.id] === q.correctIndex) {
        nextScore += 1;
      }
    }

    const allAnswered = block.questions.every((q) => nextAnswers[q.id] !== undefined);

    saveQuizAttempt(block.id, {
      answers: nextAnswers,
      submitted: allAnswered || savedAttempt.submitted,
      score: nextScore,
      total: block.questions.length,
    });
  };

  const handleRetry = () => {
    saveQuizAttempt(block.id, {
      answers: {},
      submitted: false,
      score: 0,
      total: block.questions.length,
    });
  };

  return (
    <section className="brutal-card rounded-brutal-card p-5 md:p-6 space-y-5" aria-label={block.title}>
      <div className="flex flex-wrap items-center justify-between gap-3 pb-4 border-b-2 border-ink">
        <div>
          <span className="inline-flex items-center gap-1.5 px-2.5 py-1 bg-cream border-2 border-ink rounded-brutal-tag font-mono text-xs font-bold uppercase text-ink">
            <HelpCircle className="w-3.5 h-3.5 text-primary-red" aria-hidden="true" />
            VALIDATION DES ACQUIS
          </span>
          <h3 className="font-display text-lg md:text-xl uppercase tracking-tight mt-2 text-ink">
            {block.title}
          </h3>
          {block.description && (
            <p className="text-sm text-ink/80 mt-0.5">{block.description}</p>
          )}
        </div>

        <div className="flex items-center gap-2">
          <div className="px-3 py-1.5 bg-pale-pink border-2 border-ink rounded-brutal-tag font-mono text-xs font-bold uppercase text-ink">
            SCORE : {savedAttempt.score}/{block.questions.length}
          </div>
          {Object.keys(savedAttempt.answers).length > 0 && (
            <button
              type="button"
              onClick={handleRetry}
              className="brutal-btn bg-surface px-3 py-1.5 min-h-[38px] rounded-brutal-btn font-mono text-xs font-bold uppercase inline-flex items-center gap-1.5"
            >
              <RotateCcw className="w-3.5 h-3.5" aria-hidden="true" />
              Recommencer
            </button>
          )}
        </div>
      </div>

      <div className="space-y-6">
        {block.questions.map((q, qIdx) => {
          const selectedIdx = savedAttempt.answers[q.id];
          const isAnswered = selectedIdx !== undefined;
          const isCorrect = selectedIdx === q.correctIndex;

          return (
            <div key={q.id} className="p-4 bg-cream border-2 border-ink rounded-brutal-card space-y-3">
              <p className="font-bold text-sm md:text-base text-ink">
                <span className="font-mono text-xs px-1.5 py-0.5 bg-ink text-surface rounded-brutal-tag mr-2">
                  Q{qIdx + 1}
                </span>
                {q.question}
              </p>

              <div className="space-y-2" role="radiogroup" aria-label={q.question}>
                {q.options.map((opt, optIdx) => {
                  const isThisSelected = selectedIdx === optIdx;
                  const isThisCorrectOption = optIdx === q.correctIndex;

                  let buttonStyle = 'bg-surface hover:bg-pale-pink/50 text-ink';
                  if (isAnswered) {
                    if (isThisSelected && isCorrect) {
                      buttonStyle = 'bg-primary-red text-surface font-bold shadow-brutal-xs';
                    } else if (isThisSelected && !isCorrect) {
                      buttonStyle = 'bg-ink text-surface font-bold';
                    } else if (isThisCorrectOption) {
                      buttonStyle = 'bg-pale-pink border-ink font-semibold text-ink';
                    }
                  }

                  return (
                    <button
                      key={`${q.id}-opt-${optIdx}`}
                      type="button"
                      role="radio"
                      aria-checked={isThisSelected}
                      onClick={() => handleSelectOption(q.id, optIdx)}
                      className={`w-full text-left px-3.5 py-3 border-2 border-ink rounded-brutal-btn text-xs md:text-sm transition-all flex items-center justify-between gap-3 min-h-[44px] ${buttonStyle}`}
                    >
                      <span>{opt}</span>
                      {isAnswered && isThisSelected && (
                        <span>
                          {isCorrect ? (
                            <CheckCircle2 className="w-4 h-4 shrink-0 text-surface" aria-label="Correct" />
                          ) : (
                            <XCircle
                              className="w-4 h-4 shrink-0 text-dusty-pink"
                              aria-label="Incorrect"
                            />
                          )}
                        </span>
                      )}
                    </button>
                  );
                })}
              </div>

              {isAnswered && (
                <div
                  role="status"
                  className="p-3 border-2 border-ink rounded-brutal-btn text-xs md:text-sm bg-surface text-ink"
                >
                  <strong className="font-mono uppercase mr-1.5">
                    {isCorrect ? 'CORRECT :' : 'PAS TOUT À FAIT :'}
                  </strong>
                  {q.explanation}
                </div>
              )}
            </div>
          );
        })}
      </div>
    </section>
  );
}
</file>

<file path="src/components/widgets/StepChecklist.tsx">
import { CheckSquare, Square } from 'lucide-react';
import type { StepChecklistBlock } from '../../types/course';
import { useProgress } from '../../hooks/useProgress';

export function StepChecklist({ block }: { block: StepChecklistBlock }) {
  const { state, toggleChecklistItem } = useProgress();
  const checkedMap = state.checklistAnswers[block.id] ?? {};

  const totalItems = block.items.length;
  const completedItems = block.items.filter((item) => Boolean(checkedMap[item.id])).length;
  const percentage = totalItems > 0 ? Math.round((completedItems / totalItems) * 100) : 0;

  return (
    <section className="brutal-card rounded-brutal-card p-5 md:p-6" aria-label={block.title}>
      <div className="flex flex-wrap items-center justify-between gap-3 mb-4 pb-3 border-b-2 border-ink">
        <div>
          <span className="font-mono text-xs font-bold uppercase tracking-wider px-2 py-0.5 bg-cream border border-ink rounded-brutal-tag">
            LISTE D'ACTIONS
          </span>
          <h3 className="font-display text-lg md:text-xl uppercase tracking-tight mt-1.5">
            {block.title}
          </h3>
          {block.description && (
            <p className="text-sm text-ink/80 mt-0.5">{block.description}</p>
          )}
        </div>

        <div className="flex items-center gap-2 bg-cream px-3 py-1.5 border-2 border-ink shadow-brutal-xs rounded-brutal-btn">
          <span className="font-mono text-xs font-bold uppercase">
            {completedItems}/{totalItems} TERMINÉES ({percentage}%)
          </span>
        </div>
      </div>

      <ul className="space-y-3" role="list">
        {block.items.map((item) => {
          const isChecked = Boolean(checkedMap[item.id]);
          return (
            <li key={item.id}>
              <button
                type="button"
                role="checkbox"
                aria-checked={isChecked}
                onClick={() => toggleChecklistItem(block.id, item.id)}
                className={`w-full text-left p-3.5 md:p-4 border-2 border-ink rounded-brutal-btn transition-all flex items-start gap-3.5 min-h-[48px] ${
                  isChecked
                    ? 'bg-pale-pink shadow-brutal-xs'
                    : 'bg-cream hover:bg-surface shadow-brutal-xs'
                }`}
              >
                <span
                  className={`mt-0.5 w-6 h-6 shrink-0 flex items-center justify-center border-2 border-ink rounded-brutal-tag ${
                    isChecked ? 'bg-primary-red text-surface' : 'bg-surface text-ink'
                  }`}
                  aria-hidden="true"
                >
                  {isChecked ? (
                    <CheckSquare className="w-4 h-4 stroke-[2.5]" />
                  ) : (
                    <Square className="w-4 h-4 stroke-[2]" />
                  )}
                </span>
                <div className="flex-1 min-w-0">
                  <p
                    className={`font-bold text-sm md:text-base ${
                      isChecked ? 'line-through text-ink/75' : 'text-ink'
                    }`}
                  >
                    {item.label}
                  </p>
                  {item.detail && (
                    <p className="text-xs md:text-sm text-ink/75 mt-1 leading-relaxed">
                      {item.detail}
                    </p>
                  )}
                </div>
              </button>
            </li>
          );
        })}
      </ul>
    </section>
  );
}
</file>

<file path="src/components/widgets/TextExercise.tsx">
import { Check, FileEdit } from 'lucide-react';
import type { TextExerciseBlock } from '../../types/course';
import { useProgress } from '../../hooks/useProgress';

export function TextExercise({ block }: { block: TextExerciseBlock }) {
  const { state, saveExerciseAnswer, updateProfileField } = useProgress();

  const currentAnswer =
    state.exerciseAnswers[block.id] ??
    (block.profileBinding ? state.profile[block.profileBinding] : '') ??
    '';

  const maxLength = block.maxLength ?? 1500;
  const charCount = currentAnswer.length;
  const isSaved = currentAnswer.trim().length > 0;

  const handleMainChange = (val: string) => {
    const clipped = val.slice(0, maxLength);
    saveExerciseAnswer(block.id, clipped, block.profileBinding);
  };

  return (
    <section className="brutal-card rounded-brutal-card p-5 md:p-6 space-y-5" aria-label={block.title}>
      <div className="flex flex-wrap items-center justify-between gap-3 pb-3 border-b-2 border-ink">
        <div>
          <span className="inline-flex items-center gap-1.5 px-2.5 py-1 bg-pale-pink border-2 border-ink rounded-brutal-tag font-mono text-xs font-bold uppercase text-ink">
            <FileEdit className="w-3.5 h-3.5 text-primary-red" aria-hidden="true" />
            ESPACE DE TRAVAIL PRATIQUE
          </span>
          <h3 className="font-display text-lg md:text-xl uppercase tracking-tight mt-2 text-ink">
            {block.title}
          </h3>
        </div>

        <div className="flex items-center gap-2">
          {isSaved ? (
            <span
              role="status"
              className="inline-flex items-center gap-1 px-2.5 py-1 bg-pale-pink border-2 border-ink rounded-brutal-tag font-mono text-xs font-bold uppercase text-ink"
            >
              <Check className="w-3.5 h-3.5 stroke-[2.5] text-primary-red" aria-hidden="true" />
              Enregistré automatiquement
            </span>
          ) : (
            <span className="px-2.5 py-1 bg-cream border-2 border-ink rounded-brutal-tag font-mono text-xs uppercase text-ink/70">
              En attente de saisie
            </span>
          )}
        </div>
      </div>

      <p className="text-sm md:text-base text-ink/85 leading-relaxed">{block.instructions}</p>

      <div>
        <label
          htmlFor={`exercise-textarea-${block.id}`}
          className="font-mono text-xs font-bold uppercase block mb-1.5 text-ink"
        >
          {block.profileBinding
            ? `Réponse principale (liée à la variable {{${block.profileBinding}}})`
            : 'Vos notes et livrables'}
        </label>
        <textarea
          id={`exercise-textarea-${block.id}`}
          rows={4}
          value={currentAnswer}
          onChange={(e) => handleMainChange(e.target.value)}
          placeholder={block.placeholder}
          className="w-full p-3.5 bg-cream border-2 border-ink rounded-brutal-btn font-sans text-sm md:text-base text-ink placeholder:text-ink/45 focus:bg-surface leading-relaxed"
        />
        <div className="flex items-center justify-between mt-1.5 font-mono text-xs text-ink/70">
          <span>
            {block.profileBinding
              ? `Synchronisé avec : {{${block.profileBinding}}}`
              : 'Sauvegardé automatiquement'}
          </span>
          <span>
            {charCount} / {maxLength} caractères
          </span>
        </div>
      </div>

      {block.secondaryFields && block.secondaryFields.length > 0 && (
        <div className="pt-4 border-t-2 border-ink grid grid-cols-1 md:grid-cols-2 gap-4">
          {block.secondaryFields.map((field) => {
            const fieldId = `${block.id}-secondary-${field.key}`;
            const val = state.profile[field.key] ?? '';
            return (
              <div key={field.key} className="flex flex-col">
                <label
                  htmlFor={fieldId}
                  className="font-mono text-xs font-bold uppercase mb-1.5 text-ink"
                >
                  {field.label}
                </label>
                <input
                  id={fieldId}
                  type="text"
                  value={val}
                  onChange={(e) => updateProfileField(field.key, e.target.value)}
                  placeholder={field.placeholder}
                  className="px-3.5 py-2.5 bg-cream border-2 border-ink rounded-brutal-btn text-sm text-ink placeholder:text-ink/45 focus:bg-surface min-h-[44px]"
                />
              </div>
            );
          })}
        </div>
      )}
    </section>
  );
}
</file>

