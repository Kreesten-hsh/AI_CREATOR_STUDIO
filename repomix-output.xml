import { useState } from 'react';
import { Check, Copy, ChevronDown, ChevronUp } from 'lucide-react';
import type { CopyBlockConfig } from '../../types/course';

export function CopyBlock({ block }: { block: CopyBlockConfig }) {
  const [copied, setCopied] = useState(false);
  const isCollapsible = block.defaultExpanded !== undefined || block.content.split('\n').length > 15;
  const [isExpanded, setIsExpanded] = useState(block.defaultExpanded ?? !isCollapsible);

  const buttonText =
    block.buttonText ??
    (block.label.toLowerCase().includes('prompt') ? 'Copier le prompt' : "Copier l'extrait");
  const copiedText = buttonText.toLowerCase().includes('prompt') ? 'Prompt copié' : 'Extrait copié';

  const handleCopy = async () => {
    try {
      await navigator.clipboard.writeText(block.content);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 2200);
    } catch {
      const textarea = document.createElement('textarea');
      textarea.value = block.content;
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand('copy');
      document.body.removeChild(textarea);
      setCopied(true);
      window.setTimeout(() => setCopied(false), 2200);
    }
  };

  return (
    <section
      className="brutal-card rounded-brutal-card overflow-hidden border-2 border-ink shadow-brutal bg-surface"
      aria-label={block.title}
    >
      <div className="flex flex-wrap items-center justify-between gap-3 px-4 py-3 bg-pale-pink border-b-2 border-ink">
        <div className="flex items-center gap-2 min-w-0 flex-1">
          <span className="font-mono text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 bg-surface text-ink border border-ink rounded-brutal-tag shrink-0">
            {block.label}
          </span>
          <span className="font-display text-xs md:text-sm uppercase text-ink font-bold leading-snug break-words">
            {block.title}
          </span>
        </div>

        <div className="flex flex-wrap items-center gap-2 w-full sm:w-auto sm:shrink-0">
          {isCollapsible && (
            <button
              type="button"
              onClick={() => setIsExpanded((prev) => !prev)}
              aria-expanded={isExpanded}
              aria-label={isExpanded ? 'Masquer le contenu' : 'Voir le contenu'}
              className="inline-flex items-center justify-center gap-1 px-3 py-2 min-h-[44px] border-2 border-ink rounded-brutal-btn font-mono text-xs font-bold uppercase bg-surface text-ink hover:bg-cream transition-colors shadow-brutal-xs"
            >
              {isExpanded ? (
                <>
                  <ChevronUp className="w-3.5 h-3.5" aria-hidden="true" />
                  <span>Masquer</span>
                </>
              ) : (
                <>
                  <ChevronDown className="w-3.5 h-3.5" aria-hidden="true" />
                  <span>
                    {block.label.toLowerCase().includes('prompt')
                      ? 'Voir le prompt'
                      : 'Voir le contenu'}
                  </span>
                </>
              )}
            </button>
          )}

          <button
            type="button"
            onClick={handleCopy}
            aria-label={copied ? `${copiedText} dans le presse-papier` : buttonText}
            className={`inline-flex items-center justify-center gap-1.5 px-3.5 py-2 min-h-[44px] border-2 border-ink rounded-brutal-btn font-mono text-xs font-bold uppercase transition-colors shadow-brutal-xs ${copied
                ? 'bg-ink text-surface'
                : 'bg-primary-red text-surface hover:bg-dark-red'
              }`}
          >
            {copied ? (
              <>
                <Check className="w-3.5 h-3.5 stroke-[2.5]" aria-hidden="true" />
                <span>{copiedText}</span>
              </>
            ) : (
              <>
                <Copy className="w-3.5 h-3.5 stroke-[2.2]" aria-hidden="true" />
                <span>{buttonText}</span>
              </>
            )}
          </button>
        </div>
      </div>

      {isExpanded && (
        <pre className="p-4 md:p-5 bg-cream/70 font-mono text-xs md:text-sm text-ink overflow-x-auto max-h-72 sm:max-h-80 overflow-y-auto leading-relaxed whitespace-pre-wrap break-words">
          <code>{block.content}</code>
        </pre>
      )}

      {block.notes && (
        <div className="px-4 py-2.5 bg-surface border-t-2 border-ink text-xs font-medium text-ink flex items-center gap-2">
          <span className="font-mono text-[10px] font-bold uppercase px-1.5 py-0.5 bg-cream border border-ink/40 rounded-brutal-tag text-ink">
            Note
          </span>
          <span>{block.notes}</span>
        </div>
      )}
    </section>
  );
}
</file>

<file path="src/components/widgets/ResourceCard.tsx">
import { Download, ExternalLink } from 'lucide-react';
import type { ResourceBlock, ResourceItem } from '../../types/course';

export function ResourceCard({ block }: { block: ResourceBlock }) {
  const handleDownload = (res: ResourceItem) => {
    const content =
      res.downloadContent ??
      `# ${res.title}\n\n${res.description}\n\nFormat : ${res.format}\n`;
    const blob = new Blob([content], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.href = url;
    link.download = res.downloadFilename ?? `${res.id}.md`;
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
    URL.revokeObjectURL(url);
  };

  return (
    <section
      className="brutal-card rounded-brutal-card overflow-hidden border-2 border-ink shadow-brutal bg-surface"
      aria-label={block.title}
    >
      <div className="px-4 py-3 bg-pale-pink border-b-2 border-ink flex flex-col sm:flex-row sm:items-center justify-between gap-1.5 sm:gap-3">
        <h3 className="font-display text-xs md:text-sm uppercase tracking-tight text-ink font-bold">
          {block.title}
        </h3>
        {block.description && (
          <p className="text-xs text-ink font-medium break-words">{block.description}</p>
        )}
      </div>

      <div className="p-4 sm:p-5 space-y-3">
        {block.resources.map((res) => (
          <div
            key={res.id}
            className="p-3.5 sm:p-4 bg-cream border-2 border-ink rounded-brutal-card shadow-brutal-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3"
          >
            <div className="space-y-1 min-w-0">
              <div className="flex flex-wrap items-center gap-2">
                <span className="font-mono text-[10px] font-bold uppercase px-1.5 py-0.5 bg-surface border border-ink rounded-brutal-tag text-ink shrink-0">
                  {res.format}
                </span>
                <h4 className="font-display text-sm uppercase text-ink font-bold leading-snug break-words">
                  {res.title}
                </h4>
              </div>
              <p className="text-xs text-ink leading-relaxed">{res.description}</p>
            </div>

            <div className="shrink-0">
              {res.externalUrl ? (
                <a
                  href={res.externalUrl}
                  download={res.downloadFilename}
                  target={res.externalUrl.startsWith('http') ? '_blank' : undefined}
                  rel="noopener noreferrer"
                  className="brutal-btn bg-primary-red text-surface px-4 py-2.5 min-h-[44px] rounded-brutal-btn font-mono text-xs font-bold uppercase inline-flex items-center justify-center gap-2 hover:bg-dark-red shadow-brutal-xs w-full sm:w-auto text-left whitespace-normal break-words"
                >
                  {res.downloadFilename ? (
                    <Download className="w-4 h-4 shrink-0" aria-hidden="true" />
                  ) : (
                    <ExternalLink className="w-4 h-4 shrink-0" aria-hidden="true" />
                  )}
                  <span>
                    {res.downloadFilename
                      ? `Télécharger (${res.downloadFilename})`
                      : 'Ouvrir la ressource'}
                  </span>
                </a>
              ) : (
                <button
                  type="button"
                  onClick={() => handleDownload(res)}
                  className="brutal-btn bg-primary-red text-surface px-4 py-2.5 min-h-[44px] rounded-brutal-btn font-mono text-xs font-bold uppercase inline-flex items-center justify-center gap-2 hover:bg-dark-red shadow-brutal-xs w-full sm:w-auto text-left whitespace-normal break-words"
                >
                  <Download className="w-4 h-4 shrink-0" aria-hidden="true" />
                  <span>Télécharger ({res.downloadFilename ?? 'Fichier'})</span>
                </button>
              )}
            </div>
          </div>
        ))}
      </div>
    </section>
  );
}
