    <!-- PANEL 4 : BOÎTE À PROMPTS CLAUDE -->
    <section class="tab-panel" id="tab-toolkit">
      <div class="brutal-card">
        <h2 style="font-size: 20px; font-weight: 800; margin-bottom: 8px;">
          Votre Prompt Prêt à l'Emploi (Injecté Automatiquement)
        </h2>
        <p style="font-size: 13.5px; margin-bottom: 18px; color: var(--text-muted);">
          Ce prompt intègre automatiquement vos chiffres calculés et votre profil actuel. Copiez-le d'un clic pour l'exécuter dans Claude.
        </p>

        <div class="copy-block">
          <button type="button" class="copy-btn" id="copy-btn-action" onclick="copyDynamicPrompt()">
            Copier le prompt
          </button>
          <pre class="copy-pre" id="dynamic-prompt-display">Chargement du prompt dynamique...</pre>
        </div>

        <div class="notice-box" style="margin-top: 20px;">
          <strong>Architecture de persistance et de portabilité :</strong><br>
          Cet outil illustre l'architecture recommandée dans le Module 02 : les interactions fonctionnent hors ligne sans dépendance serveur, la sauvegarde automatique utilise <code>localStorage</code> lorsqu'il est hébergé sur une origine HTTPS stable, et l'export/import <code>.json</code> garantit que l'utilisateur final ne perd jamais ses données s'il change d'appareil ou ouvre le fichier localement.
        </div>
      </div>
    </section>

  </div>

  <script>
    const STORAGE_KEY = 'demo_apres_hub_creation_v2';
    const ALL_TASK_IDS = [
      'task-1', 'task-2', 'task-3', 'task-4', 'task-5',
      'task-6', 'task-7', 'task-8', 'task-9', 'task-10', 'task-11'
    ];

    const profileData = {
      freelance: {
        label: 'Freelance Solo en mission',
        hoursClient: 25,
        hoursAdmin: 8,
        hoursTotal: 40,
        volumeText: '1 publication pilier + 2 déclinaisons',
        pillarA: 'Pourquoi sous-facturer au TJM fragilise la rentabilité d\'un freelance.',
        pillarB: 'Décorticage d\'un livrable structuré en 4 étapes pour un client PME.',
        pillarC: 'Invitation à utiliser le calculateur de capacité avant un premier appel.'
      },
      trainer: {
        label: 'Formateur / Infopreneur',
        hoursClient: 15,
        hoursAdmin: 6,
        hoursTotal: 38,
        volumeText: '1 publication longue + 4 déclinaisons actives',
        pillarA: 'Pourquoi les supports passifs sans plan d\'action sont rarement mis en pratique.',
        pillarB: 'Démonstration d\'un exercice guidé permettant de structurer un cours en 3 modules.',
        pillarC: 'Accès direct à la grille d\'auto-évaluation du programme.'
      },
      coach: {
        label: 'Coach / Consultant',
        hoursClient: 20,
        hoursAdmin: 7,
        hoursTotal: 38,
        volumeText: '1 publication longue + 4 déclinaisons actives',
        pillarA: 'Le piège des séances facturées à l\'heure plutôt qu\'au périmètre de mission.',
        pillarB: 'Étude de cas méthodologique sur la réorganisation d\'un dirigeant de PME.',
        pillarC: 'Lien vers le diagnostic préalable avant un entretien de cadrage.'
      }
    };

    let currentProfile = 'freelance';
    let hoursTotal = 40;
    let hoursClient = 25;
    let hoursAdmin = 8;
    let checkedTasks = {};
    let isLocalStorageAvailable = false;

    function updateStorageStatusUI(available) {
      isLocalStorageAvailable = available;
      const el = document.getElementById('storage-status-indicator');
      if (!el) return;
      if (available) {
        el.textContent = 'Sauvegarde navigateur active';
      } else {
        el.textContent = 'Mode local : utilisez Exporter (.json) pour sauvegarder';
      }
    }

    function showFeedback(message) {
      const toast = document.getElementById('portable-feedback');
      if (toast) {
        toast.textContent = message;
      }
    }

    function getSerializableState() {
      return {
        schemaVersion: 2,
        currentProfile: currentProfile,
        hoursTotal: Number(hoursTotal) || 0,
        hoursClient: Number(hoursClient) || 0,
        hoursAdmin: Number(hoursAdmin) || 0,
        checkedTasks: Object.assign({}, checkedTasks),
        exportedAt: new Date().toISOString()
      };
    }

    function applyImportedState(parsed) {
      if (!parsed || typeof parsed !== 'object') {
        throw new Error('Format JSON invalide');
      }
      if (typeof parsed.currentProfile === 'string' && profileData[parsed.currentProfile]) {
        currentProfile = parsed.currentProfile;
      }
      if (typeof parsed.hoursTotal === 'number' && Number.isFinite(parsed.hoursTotal)) {
        hoursTotal = Math.max(0, Math.min(120, parsed.hoursTotal));
      } else {
        hoursTotal = profileData[currentProfile].hoursTotal;
      }
      if (typeof parsed.hoursClient === 'number' && Number.isFinite(parsed.hoursClient)) {
        hoursClient = Math.max(0, Math.min(120, parsed.hoursClient));
      } else {
        hoursClient = profileData[currentProfile].hoursClient;
      }
      if (typeof parsed.hoursAdmin === 'number' && Number.isFinite(parsed.hoursAdmin)) {
        hoursAdmin = Math.max(0, Math.min(120, parsed.hoursAdmin));
      } else {
        hoursAdmin = profileData[currentProfile].hoursAdmin;
      }
      const nextTasks = {};
      if (parsed.checkedTasks && typeof parsed.checkedTasks === 'object') {
        ALL_TASK_IDS.forEach(function(id) {
          if (parsed.checkedTasks[id] === true) {
            nextTasks[id] = true;
          }
        });
      }
      checkedTasks = nextTasks;

      syncDOMWithState();
      saveState();
    }

    function loadState() {
      try {
        const testKey = '__hub_storage_check__';
        window.localStorage.setItem(testKey, '1');
        window.localStorage.removeItem(testKey);
        updateStorageStatusUI(true);

        const saved = window.localStorage.getItem(STORAGE_KEY);
        if (saved) {
          const parsed = JSON.parse(saved);
          applyImportedState(parsed);
          return;
        }
      } catch (e) {
        updateStorageStatusUI(false);
      }
      syncDOMWithState();
    }

    function saveState() {
      try {
        window.localStorage.setItem(STORAGE_KEY, JSON.stringify(getSerializableState()));
        updateStorageStatusUI(true);
      } catch (e) {
        updateStorageStatusUI(false);
      }
    }

    function syncDOMWithState() {
      document.querySelectorAll('.profile-btn').forEach(function(btn) {
        btn.classList.toggle('active', btn.dataset.profile === currentProfile);
      });

      const data = profileData[currentProfile];
      document.getElementById('hours-total').value = String(hoursTotal);
      document.getElementById('hours-client').value = String(hoursClient);
      document.getElementById('hours-admin').value = String(hoursAdmin);
      document.getElementById('current-profile-label').textContent = data.label;

      document.getElementById('pillar-a-example').innerHTML = '<strong>Votre exemple :</strong> ' + data.pillarA;
      document.getElementById('pillar-b-example').innerHTML = '<strong>Votre exemple :</strong> ' + data.pillarB;
      document.getElementById('pillar-c-example').innerHTML = '<strong>Votre exemple :</strong> ' + data.pillarC;

      calculateCapacity();
      updateProgress();
    }

    function selectProfile(profileKey) {
      if (!profileData[profileKey]) return;
      currentProfile = profileKey;
      const data = profileData[profileKey];
      hoursTotal = data.hoursTotal;
      hoursClient = data.hoursClient;
      hoursAdmin = data.hoursAdmin;
      syncDOMWithState();
      saveState();
    }

    function onHoursInputChange() {
      hoursTotal = parseFloat(document.getElementById('hours-total').value) || 0;
      hoursClient = parseFloat(document.getElementById('hours-client').value) || 0;
      hoursAdmin = parseFloat(document.getElementById('hours-admin').value) || 0;
      calculateCapacity();
      saveState();
    }

    function calculateCapacity() {
      const available = Math.max(0, hoursTotal - hoursClient - hoursAdmin);
      const capacityNum = available * 0.65;
      const capacity = capacityNum.toFixed(1);

      document.getElementById('res-hours').textContent = capacity + ' h';

      let volume = '1 micro-publication par semaine';
      if (capacityNum >= 3 && capacityNum < 6) {
        volume = '1 publication pilier + 2 déclinaisons';
      } else if (capacityNum >= 6) {
        volume = '1 publication longue + 4 déclinaisons actives';
      }
      document.getElementById('res-content-volume').textContent = volume;

      updateDynamicPrompt();
    }

    function toggleTask(taskId) {
      if (ALL_TASK_IDS.indexOf(taskId) === -1) return;
      checkedTasks[taskId] = !checkedTasks[taskId];
      updateProgress();
      saveState();
    }

    function updateProgress() {
      let completedCount = 0;

      ALL_TASK_IDS.forEach(function(id) {
        const isDone = Boolean(checkedTasks[id]);
        const el = document.getElementById(id);
        if (el) el.classList.toggle('checked', isDone);
        if (isDone) completedCount++;
      });

      const pct = Math.round((completedCount / ALL_TASK_IDS.length) * 100);
      document.getElementById('progress-fill').style.width = pct + '%';
      document.getElementById('progress-text').textContent = completedCount + ' / ' + ALL_TASK_IDS.length + ' actions validées (' + pct + ' %)';

      const week1Done = checkedTasks['task-1'] && checkedTasks['task-2'] && checkedTasks['task-3'];
      const week2Done = checkedTasks['task-4'] && checkedTasks['task-5'] && checkedTasks['task-6'];
      const allDone = completedCount === ALL_TASK_IDS.length;

      document.getElementById('badge-1').classList.toggle('unlocked', Boolean(week1Done));
      document.getElementById('badge-2').classList.toggle('unlocked', Boolean(week2Done));
      document.getElementById('badge-3').classList.toggle('unlocked', Boolean(allDone));
    }

    function markStepOneDone() {
      checkedTasks['task-1'] = true;
      updateProgress();
      saveState();
      switchTab('tab-pillars');
    }

    function switchTab(tabId) {
      const panelIds = ['tab-diag', 'tab-pillars', 'tab-roadmap', 'tab-toolkit'];
      document.querySelectorAll('.tab-btn').forEach(function(btn, idx) {
        btn.classList.toggle('active', panelIds[idx] === tabId);
      });

      document.querySelectorAll('.tab-panel').forEach(function(panel) {
        panel.classList.toggle('active', panel.id === tabId);
      });
    }

    function updateDynamicPrompt() {
      const p = profileData[currentProfile];
      const cap = document.getElementById('res-hours').textContent;
      const vol = document.getElementById('res-content-volume').textContent;

      const promptText = 'Agis comme mon Directeur Éditorial Senior.\n\n' +
        'CONTEXTE DE MON ACTIVITÉ :\n' +
        '- Profil : ' + p.label + '\n' +
        '- Capacité hebdomadaire de création protégée : ' + cap + '\n' +
        '- Objectif de volume recommandé : ' + vol + '\n\n' +
        'MISSION :\n' +
        'Conçois mon calendrier éditorial sur 2 semaines structuré selon la matrice des 3 Piliers :\n' +
        '1. Pilier Fondation (40 %) : un sujet fort qui corrige une erreur fréquente de mon marché.\n' +
        '2. Pilier Preuve (40 %) : une étude de cas démontrant la méthode exacte.\n' +
        '3. Pilier Conversion (20 %) : une invitation précise vers un diagnostic ou outil interactif.\n\n' +
        'Pour chaque publication, fournis :\n' +
        '- L\'accroche exacte (3 variantes)\n' +
        '- Le déroulé pas à pas\n' +
        '- L\'appel à l\'action direct.';

      document.getElementById('dynamic-prompt-display').textContent = promptText;
    }

    function copyDynamicPrompt() {
      const text = document.getElementById('dynamic-prompt-display').textContent;
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(text).then(function() {
          const btn = document.getElementById('copy-btn-action');
          btn.textContent = 'Prompt Copié !';
          setTimeout(function() {
            btn.textContent = 'Copier le prompt';
          }, 2000);
        });
      }
    }

    function exportDataJson() {
      const payload = JSON.stringify(getSerializableState(), null, 2);
      const blob = new Blob([payload], { type: 'application/json;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'sauvegarde-systeme-creation.json';
      a.click();
      URL.revokeObjectURL(url);
      showFeedback('Sauvegarde JSON générée avec succès.');
      return payload;
    }

    function importDataJsonString(jsonString) {
      try {
        const parsed = JSON.parse(jsonString);
        applyImportedState(parsed);
        showFeedback('Données JSON restaurées avec succès.');
        return true;
      } catch (e) {
        showFeedback('Erreur : le fichier JSON fourni est invalide.');
        return false;
      }
    }

    function handleFileImport(event) {
      const file = event && event.target && event.target.files ? event.target.files[0] : null;
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(loadEvent) {
        const content = loadEvent && loadEvent.target ? String(loadEvent.target.result || '') : '';
        importDataJsonString(content);
      };
      reader.readAsText(file);
    }

    function exportRoadmapText() {
      const p = profileData[currentProfile];
      const cap = document.getElementById('res-hours').textContent;
      const vol = document.getElementById('res-content-volume').textContent;

      let content = 'FEUILLE DE ROUTE PERSONNELLE : SYSTÈME DE CRÉATION RÉGULIÈRE\n';
      content += 'Profil : ' + p.label + '\n';
      content += 'Capacité hebdomadaire protégée : ' + cap + '\n';
      content += 'Volume cible : ' + vol + '\n\n';
      content += 'ÉTAT DES ACTIONS (30 JOURS) :\n';

      ALL_TASK_IDS.forEach(function(id) {
        const el = document.getElementById(id);
        const label = el ? el.textContent.trim() : id;
        const mark = checkedTasks[id] ? '[X]' : '[ ]';
        content += mark + ' ' + label + '\n';
      });

      const blob = new Blob([content], { type: 'text/plain;charset=utf-8' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = 'feuille-de-route-creation-reguliere.txt';
      a.click();
      URL.revokeObjectURL(url);
    }

    function resetAllProgress() {
      checkedTasks = {};
      selectProfile('freelance');
      showFeedback('Hub réinitialisé aux valeurs par défaut.');
    }

    // Expose hooks for automated verification
    window.__HUB_PROTOTYPE__ = {
      getSerializableState: getSerializableState,
      importDataJsonString: importDataJsonString,
      selectProfile: selectProfile,
      toggleTask: toggleTask,
      onHoursInputChange: onHoursInputChange,
      resetAllProgress: resetAllProgress
    };

    // Init on load
    loadState();
  </script>

</body>
</html>
