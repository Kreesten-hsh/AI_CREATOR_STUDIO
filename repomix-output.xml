    for (const step of day02.steps) {
      const videoBlocks = step.blocks.filter((b): b is VideoBlockConfig => b.type === 'video');
      for (const vb of videoBlocks) {
        expect(isValidVideoUrl(vb.videoUrl)).toBe(true);
      }
