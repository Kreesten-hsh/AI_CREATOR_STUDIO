      const { result } = renderHook(() => useProgress(), {
        wrapper: ({ children }) => <ProgressProvider>{children}</ProgressProvider>,
      });

      act(() => result.current.navigateToDay(1));
      expect(result.current.state.activeRoute).toEqual({
