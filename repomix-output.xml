                        <Check className="w-3 h-3 stroke-[3]" /> CHOISIE
                      </span>
                    )}
                  </div>
                  <p className="text-xs text-ink/75 mb-3">{palette.tagline}</p>
                  <div className="flex items-center gap-2">
