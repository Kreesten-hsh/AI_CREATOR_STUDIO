              <button
                key={lesson.id}
                type="button"
                onClick={() => handleSelectLesson(idx)}
                aria-current={isActive ? 'page' : undefined}
                className={`p-3 text-left border-2 border-ink rounded-brutal-btn transition-all flex flex-col justify-between min-h-[64px] ${
