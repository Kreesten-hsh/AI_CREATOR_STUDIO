import { useEffect, useRef, useState } from 'react';
import {
  X,
  Copy,
  Check,
  Download,
  AlertTriangle,
  Target,
  FileCheck2,
  HelpCircle,
  ShieldAlert,
} from 'lucide-react';
import type { MarketingResource } from '../../types/marketing';

interface MarketingDetailModalProps {
  resource: MarketingResource | null;
  onClose: () => void;
}

export function MarketingDetailModal({ resource, onClose }: MarketingDetailModalProps) {
  const [copied, setCopied] = useState(false);
  const [copyError, setCopyError] = useState(false);

  const modalRef = useRef<HTMLDivElement>(null);
  const closeButtonRef = useRef<HTMLButtonElement>(null);
  const triggerElementRef = useRef<HTMLElement | null>(null);

  // Capture et restauration du focus
  useEffect(() => {
    if (resource) {
      triggerElementRef.current = document.activeElement as HTMLElement | null;
      // Déplacement du focus vers le conteneur ou le bouton de fermeture
      setTimeout(() => {
        closeButtonRef.current?.focus();
      }, 0);
    } else if (triggerElementRef.current) {
      triggerElementRef.current.focus();
    }
  }, [resource]);

  // Focus trap, touche Escape et verrouillage du scroll arrière-plan
  useEffect(() => {
    if (!resource) return;

    const handleKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') {
        onClose();
        return;
      }

      if (event.key === 'Tab' && modalRef.current) {
        const focusableElements = modalRef.current.querySelectorAll<HTMLElement>(
          'button, [href], input, select, textarea, [tabindex]:not([tabindex="-1"])'
        );
        const focusable = Array.from(focusableElements).filter(
          (el) => !el.hasAttribute('disabled') && el.offsetParent !== null
        );

        if (focusable.length === 0) return;

        const firstElement = focusable[0];
        const lastElement = focusable[focusable.length - 1];

        if (event.shiftKey) {
          if (document.activeElement === firstElement) {
            event.preventDefault();
            lastElement.focus();
          }
        } else {
          if (document.activeElement === lastElement) {
            event.preventDefault();
            firstElement.focus();
          }
        }
      }
    };

    document.addEventListener('keydown', handleKeyDown);
    const originalOverflow = document.body.style.overflow;
    document.body.style.overflow = 'hidden';

    return () => {
      document.removeEventListener('keydown', handleKeyDown);
      document.body.style.overflow = originalOverflow;
    };
  }, [resource, onClose]);

  if (!resource) return null;

  const handleCopyPrompt = async () => {
    const textToCopy = resource.readyPrompt.fullPrompt;
    let successful = false;

    if (typeof navigator !== 'undefined' && navigator.clipboard) {
      try {
        await navigator.clipboard.writeText(textToCopy);
        successful = true;
      } catch {
        // Fallback ci-dessous
      }
    }

    if (!successful) {
      try {
        const textArea = document.createElement('textarea');
        textArea.value = textToCopy;
        textArea.style.position = 'fixed';
        textArea.style.left = '-999999px';
        textArea.style.top = '-999999px';
        document.body.appendChild(textArea);
        textArea.focus();
        textArea.select();
        successful = document.execCommand('copy');
        document.body.removeChild(textArea);
      } catch {
        successful = false;
      }
    }

    if (successful) {
      setCopied(true);
      setCopyError(false);
      setTimeout(() => setCopied(false), 2000);
    } else {
      setCopyError(true);
      setTimeout(() => setCopyError(false), 3000);
    }
  };

  return (
    <div
      role="dialog"
      aria-modal="true"
      aria-labelledby="modal-resource-title"
      className="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 md:p-8 bg-ink/70 backdrop-blur-xs overflow-y-auto"
      onClick={onClose}
    >
      <div
        ref={modalRef}
        tabIndex={-1}
        className="relative w-full max-w-4xl bg-surface border-2 border-ink rounded-brutal-card shadow-brutal my-auto overflow-hidden max-h-[92vh] flex flex-col focus:outline-none"
        onClick={(e) => e.stopPropagation()}
      >
        {/* En-tête de la modale */}
        <header className="p-5 sm:p-6 border-b-2 border-ink bg-cream/70 flex items-start justify-between gap-4">
          <div className="space-y-1.5">
            <div className="flex flex-wrap items-center gap-2">
              <span className="px-2.5 py-0.5 bg-primary-red text-surface font-mono text-[11px] font-bold uppercase rounded-brutal-tag border border-ink shadow-brutal-xs">
                {resource.categoryLabel}
              </span>
