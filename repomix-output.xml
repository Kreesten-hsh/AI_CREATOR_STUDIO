      const allSteps = day01.lessons.flatMap((l) => l.steps);
      const stepsWithScreenshots = allSteps.filter((s) => s.blocks.some((b) => b.type === 'screenshot'));
      expect(stepsWithScreenshots).toHaveLength(2);
