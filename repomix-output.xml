            <div className="space-y-2 text-xs sm:text-sm">
              <p className="text-ink/80 leading-relaxed">
                <strong className="text-ink font-semibold">Le défi : </strong>
                {resource.digitalProductScenario.context}
              </p>
              <p className="text-ink/90 leading-relaxed bg-cream/60 p-3 rounded border border-ink/30">
                <strong className="text-ink font-semibold">Application du Skill : </strong>
                {resource.digitalProductScenario.execution}
              </p>
            </div>
          </section>

          {/* Section D : Exemple de prompt copiable */}
          <section className="space-y-3">
            <div className="flex flex-wrap items-center justify-between gap-2">
              <div>
                <h3 className="font-display text-lg uppercase tracking-tight text-ink">
                  Prompt Prêt à l'Emploi
                </h3>
                <p className="text-xs text-ink/75">
                  {resource.readyPrompt.mission}
                </p>
              </div>

              <button
                type="button"
                onClick={handleCopyPrompt}
                className="brutal-btn rounded-brutal-btn px-4 py-2 min-h-[38px] font-mono text-xs font-bold uppercase inline-flex items-center justify-center gap-1.5 bg-primary-red text-surface border-2 border-ink hover:bg-dark-red shadow-brutal-xs"
              >
                {copied ? (
                  <>
                    <Check className="w-4 h-4 text-surface stroke-[2.5]" aria-hidden="true" />
                    <span>Prompt copié !</span>
                  </>
                ) : copyError ? (
                  <>
                    <AlertTriangle className="w-4 h-4 text-surface" aria-hidden="true" />
                    <span>Échec copie</span>
                  </>
                ) : (
                  <>
                    <Copy className="w-4 h-4 text-surface stroke-[2]" aria-hidden="true" />
                    <span>Copier le prompt</span>
                  </>
                )}
              </button>
            </div>

            {copyError && (
              <p className="text-xs font-mono text-primary-red bg-pale-pink/60 p-2 rounded border border-ink/30">
                La copie automatique a échoué. Veuillez sélectionner et copier le texte manuellement ci-dessous.
              </p>
            )}

            {/* Bloc de code prompt */}
            <div className="p-4 bg-ink text-surface rounded-brutal-card border-2 border-ink font-mono text-xs leading-relaxed overflow-x-auto max-h-[340px]">
              <pre className="whitespace-pre-wrap text-[11px] sm:text-xs text-surface/90">
                {resource.readyPrompt.fullPrompt}
              </pre>
            </div>
            <p className="font-serif text-xs text-ink/70 italic">
              {resource.readyPrompt.explanation}
            </p>
          </section>

          {/* Section E : Résultat attendu */}
          <section className="p-4 sm:p-5 bg-pale-pink/30 border border-ink rounded-brutal-card space-y-2">
            <div className="flex items-center gap-2">
              <FileCheck2 className="w-4 h-4 text-primary-red" aria-hidden="true" />
              <h3 className="font-mono text-xs font-bold uppercase tracking-wider text-ink">
                Résultat concret attendu
              </h3>
            </div>
            <p className="text-xs sm:text-sm text-ink/85 leading-relaxed">
              {resource.expectedResult.summary}
            </p>
            <div className="p-3 bg-surface border border-ink/40 rounded text-xs font-mono text-ink/90 whitespace-pre-line leading-relaxed">
              {resource.expectedResult.sampleOutput}
            </div>
          </section>

          {/* Section F & G : Téléchargement et Instructions */}
          <div className="grid grid-cols-1 md:grid-cols-12 gap-4 pt-2 border-t-2 border-ink/15">
            {/* Téléchargement ou Statut Droits */}
            <section className="md:col-span-5 p-4 bg-cream border border-ink rounded-brutal-card flex flex-col justify-between gap-3">
              <div className="space-y-1.5">
                <span className="font-mono text-[11px] font-bold uppercase tracking-wider text-primary-red block">
                  Archive originale du Skill
                </span>
                <span className="font-mono text-xs text-ink/80 block">
                  {resource.download.fileName} {resource.download.fileSize ? `(${resource.download.fileSize})` : ''}
                </span>
                <div className="text-[11px] text-ink/70 font-mono">
                  Fichiers de référence :
                  <ul className="list-disc list-inside">
                    {resource.download.includedFiles.map((file, i) => (
                      <li key={i} className="truncate">{file}</li>
                    ))}
                  </ul>
                </div>

                {resource.download.licenseInfo && (
                  <p className="text-[10px] font-mono text-ink/75 pt-1 border-t border-ink/20">
                    {resource.download.licenseInfo}
                  </p>
                )}
              </div>

              {resource.download.isAvailable && resource.download.downloadUrl ? (
                <a
                  href={resource.download.downloadUrl}
                  download
                  className="brutal-btn rounded-brutal-btn px-4 py-2.5 min-h-[40px] font-mono text-xs font-bold uppercase inline-flex items-center justify-center gap-2 bg-surface text-ink border-2 border-ink hover:bg-pale-pink shadow-brutal-xs"
                >
                  <Download className="w-4 h-4 text-primary-red stroke-[2.5]" aria-hidden="true" />
                  <span>Télécharger l'archive</span>
                </a>
              ) : (
                <div className="p-3 bg-surface/90 border border-ink/40 rounded-brutal-card space-y-1">
                  <div className="flex items-center gap-1.5 text-primary-red font-mono text-[10px] font-bold uppercase">
                    <ShieldAlert className="w-3.5 h-3.5" aria-hidden="true" />
                    <span>Statut de distribution</span>
                  </div>
                  <p className="text-[11px] font-serif text-ink/80 leading-relaxed">
                    {resource.download.statusNote ||
                      'Téléchargement de l’archive ZIP indisponible (en attente de clarification des droits de redistribution).'}
                  </p>
                </div>
              )}
            </section>

            {/* Instructions */}
            <section className="md:col-span-7 p-4 bg-surface border border-ink rounded-brutal-card space-y-2">
              <span className="font-mono text-[11px] font-bold uppercase tracking-wider text-ink block">
                Guide d'utilisation & compatibilité
              </span>
              <ol className="space-y-1 text-xs text-ink/85">
                {resource.usageInstructions.quickStart.map((step, idx) => (
                  <li key={idx} className="flex items-start gap-1.5">
                    <span className="font-mono font-bold text-primary-red">{idx + 1}.</span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
              <p className="text-[11px] text-ink/70 pt-1 border-t border-ink/15">
                {resource.usageInstructions.compatibilityNotes}
              </p>
            </section>
          </div>
        </div>

        {/* Pied de la modale */}
        <footer className="p-4 sm:p-5 border-t-2 border-ink bg-cream/60 flex items-center justify-between gap-3">
          <span className="font-mono text-xs text-ink/75">
            AI CREATOR STUDIO • BONUS 02
          </span>
          <button
            type="button"
            onClick={onClose}
            className="brutal-btn rounded-brutal-btn px-4 py-2 min-h-[38px] font-mono text-xs font-bold uppercase bg-surface text-ink border-2 border-ink hover:bg-cream"
          >
            Fermer la fiche
          </button>
        </footer>
      </div>
    </div>
  );
}
