<file path="src/utils/courseNavigation.ts">
import { MAIN_COURSES } from '../data/navigation/mainCourses';
import { BONUSES } from '../data/navigation/bonuses';
import { ALL_DAYS, ALL_LESSONS, TOTAL_COURSE_DAYS, TOTAL_COURSE_LESSONS, TOTAL_COURSE_MODULES } from '../data/course';
import {
  ALL_DAY_IDS,
  ALL_LESSON_IDS,
  ALL_MODULE_IDS,
  type ActiveRoute,
  type CourseModule,
  type Day,
  type Lesson,
  type LessonId,
  type ModuleId,
} from '../types/course';

const VALID_LESSON_ID_SET = new Set<string>(ALL_LESSON_IDS);
const VALID_BONUS_IDS = new Set<string>(BONUSES.map((b) => b.id));

/**
 * Normalise un identifiant de leçon s'il correspond à l'une des 7 leçons officielles.
 */
export function normalizeLessonId(rawId: unknown): LessonId | null {
  if (typeof rawId !== 'string') {
    return null;
  }
  const normalized = rawId.trim().toLowerCase();
  if (VALID_LESSON_ID_SET.has(normalized)) {
    return normalized as LessonId;
  }
  return null;
}

/**
 * Récupère un module à partir de son identifiant officiel ('module-01' à 'module-03').
 */
export function getCourseById(courseId: string): CourseModule | undefined {
  return MAIN_COURSES.find((c) => c.id === courseId);
}

/**
 * Récupère une journée à partir de son identifiant ('day-01' à 'day-03').
 */
export function getDayById(dayId: string): Day | undefined {
  return ALL_DAYS.find((d) => d.id === dayId);
}

/**
 * Récupère une journée à partir de son numéro temporel (1 à 3).
 */
export function getDayByNumber(dayNumber: number): Day | undefined {
  return ALL_DAYS.find((d) => d.dayNumber === dayNumber);
}

/**
 * Récupère une leçon à partir de son identifiant ('lesson-01' à 'lesson-07').
 */
export function getLessonById(lessonId: string): Lesson | undefined {
  const validId = normalizeLessonId(lessonId);
  if (!validId) return undefined;
  return ALL_LESSONS.find((l) => l.id === validId);
}

/**
 * Récupère une leçon à partir de son numéro séquentiel (1 à 7).
 */
export function getLessonByNumber(lessonNumber: number): Lesson | undefined {
  if (!Number.isInteger(lessonNumber) || lessonNumber < 1 || lessonNumber > TOTAL_COURSE_LESSONS) {
    return undefined;
  }
  return ALL_LESSONS.find((l) => l.lessonNumber === lessonNumber);
}

/**
 * Identifie le module auquel appartient une journée (1 à 3).
 */
export function getCourseByDayNumber(dayNumber: number): CourseModule | undefined {
  return MAIN_COURSES.find((c) => c.dayNumber === dayNumber);
}

/**
 * Identifie le module auquel appartient une leçon par son identifiant ('lesson-01' à 'lesson-07').
 */
export function getCourseByLessonId(lessonId: string): CourseModule | undefined {
  const lesson = getLessonById(lessonId);
  if (!lesson) return undefined;
  return getCourseById(lesson.moduleId);
}

/**
 * Identifie le module auquel appartient une leçon par son numéro (1 à 7).
 */
export function getCourseByLessonNumber(lessonNumber: number): CourseModule | undefined {
  const lesson = getLessonByNumber(lessonNumber);
  if (!lesson) return undefined;
  return getCourseById(lesson.moduleId);
}

/**
 * Vérifie si une leçon (par identifiant ou numéro) appartient à un module donné.
 */
export function isLessonInCourse(lessonIdOrNumber: string | number, courseId: string): boolean {
  const course = getCourseById(courseId);
  if (!course) return false;
  if (typeof lessonIdOrNumber === 'number') {
    const [start, end] = course.lessonRange;
    return lessonIdOrNumber >= start && lessonIdOrNumber <= end;
  }
  const normalized = normalizeLessonId(lessonIdOrNumber);
  return normalized ? course.lessonIds.includes(normalized) : false;
}

/**
 * Vérifie si un numéro de journée (1 à 3) correspond au module donné.
 */
export function isDayInCourse(dayNumber: number, courseId: string): boolean {
  const course = getCourseById(courseId);
  if (!course) return false;
  return course.dayNumber === dayNumber;
}

/**
 * Résout l'identifiant de module correspondant à une leçon (par ID ou par numéro 1..7).
 * Retourne le fallback explicite s'il est fourni, sinon null.
 */
export function resolveCourseIdForLesson(
  lessonIdOrNumber: string | number,
  fallbackCourseId?: ModuleId
): ModuleId | null {
  const course =
    typeof lessonIdOrNumber === 'number'
      ? getCourseByLessonNumber(lessonIdOrNumber)
      : getCourseByLessonId(lessonIdOrNumber);
  if (course) {
    return course.id;
  }
  return fallbackCourseId ?? null;
}

/**
 * Résout l'identifiant de module correspondant à une journée (1 à 3).
 */
export function resolveCourseIdForDay(
  dayNumber: number,
  fallbackCourseId?: ModuleId
): ModuleId | null {
  const course = getCourseByDayNumber(dayNumber);
  if (course) {
    return course.id;
  }
  return fallbackCourseId ?? null;
}

export interface CourseIntegrityResult {
  isValid: boolean;
  errors: string[];
}

/**
 * Valide l'intégrité structurelle stricte du cursus canonique :
 * - Exactement 3 modules ('module-01' à 'module-03')
 * - Exactement 3 journées ('day-01' à 'day-03') sans tableau steps
 * - Exactement 7 leçons ('lesson-01' à 'lesson-07') réparties en 2 + 3 + 2
 * - Absence de chevauchement ou de trou dans les numéros et identifiants
 */
export function validateCourseIntegrity(
  modules: readonly CourseModule[] = MAIN_COURSES,
  days: readonly Day[] = ALL_DAYS
): CourseIntegrityResult {
  const errors: string[] = [];

  if (modules.length !== TOTAL_COURSE_MODULES) {
    errors.push(`Attendu ${TOTAL_COURSE_MODULES} modules exactement, reçu ${modules.length}`);
  }

  if (days.length !== TOTAL_COURSE_DAYS) {
    errors.push(`Attendu ${TOTAL_COURSE_DAYS} journées exactement, reçu ${days.length}`);
  }

  const moduleIds = modules.map((m) => m.id);
  const uniqueModuleIds = new Set(moduleIds);
  if (uniqueModuleIds.size !== modules.length) {
    errors.push('Identifiants de module dupliqués détectés');
  }

  for (const expectedModId of ALL_MODULE_IDS) {
    if (!uniqueModuleIds.has(expectedModId)) {
      errors.push(`Identifiant officiel de module manquant : ${expectedModId}`);
    }
  }

  const dayIds = days.map((d) => d.id);
  const uniqueDayIds = new Set(dayIds);
  if (uniqueDayIds.size !== days.length) {
    errors.push('Identifiants de journée dupliqués détectés');
  }

  for (const expectedDayId of ALL_DAY_IDS) {
    if (!uniqueDayIds.has(expectedDayId)) {
      errors.push(`Identifiant officiel de journée manquant : ${expectedDayId}`);
    }
  }

  const lessonCoverageByModule = new Map<number, string[]>();

  for (const mod of modules) {
    if (!mod.lessonRange || mod.lessonRange.length !== 2) {
      errors.push(`Plage de leçons manquante ou invalide pour le module ${mod.id}`);
      continue;
    }

    const [start, end] = mod.lessonRange;
    if (!Number.isInteger(start) || !Number.isInteger(end) || start < 1 || start > end) {
      errors.push(`Plage invalide [${start}, ${end}] pour le module ${mod.id}`);
      continue;
    }

    for (let lessonNum = start; lessonNum <= end; lessonNum++) {
      const assigned = lessonCoverageByModule.get(lessonNum) ?? [];
      assigned.push(mod.id);
      lessonCoverageByModule.set(lessonNum, assigned);
    }
  }

  for (let lessonNum = 1; lessonNum <= TOTAL_COURSE_LESSONS; lessonNum++) {
    const assignedModules = lessonCoverageByModule.get(lessonNum);
    if (!assignedModules || assignedModules.length === 0) {
      errors.push(`Leçon ${lessonNum} non attribuée à aucun module (trou détecté)`);
    } else if (assignedModules.length > 1) {
      errors.push(
        `Leçon ${lessonNum} attribuée à plusieurs modules : ${assignedModules.join(', ')} (chevauchement)`
      );
    }
  }

  for (const [lessonNum, assignedModules] of lessonCoverageByModule.entries()) {
    if (lessonNum < 1 || lessonNum > TOTAL_COURSE_LESSONS) {
      errors.push(
        `Leçon ${lessonNum} hors de la plage officielle [1, ${TOTAL_COURSE_LESSONS}] attribuée à ${assignedModules.join(', ')}`
      );
    }
  }

  const allLessonsFromDays = days.flatMap((d) => d.lessons ?? []);
  if (allLessonsFromDays.length !== TOTAL_COURSE_LESSONS) {
    errors.push(
      `Attendu ${TOTAL_COURSE_LESSONS} leçons au total dans les journées, reçu ${allLessonsFromDays.length}`
    );
  }

  // Vérification de la cohérence des modules avec leurs journées et leurs leçons
  for (const mod of modules) {
    const matchingDay = days.find((d) => d.id === mod.dayId);
    if (!matchingDay) {
      errors.push(`Module ${mod.id} : journée associée '${mod.dayId}' introuvable dans les journées.`);
      continue;
    }
    if (matchingDay.dayNumber !== mod.dayNumber) {
      errors.push(
        `Module ${mod.id} : incohérence de numéro de journée (module.dayNumber=${mod.dayNumber} vs day.dayNumber=${matchingDay.dayNumber}).`
      );
    }
    if (matchingDay.moduleId !== mod.id) {
      errors.push(
        `Module ${mod.id} : incohérence de module dans la journée associée (day.moduleId=${matchingDay.moduleId} vs module.id=${mod.id}).`
      );
    }

    const dayLessonIds = matchingDay.lessons ? matchingDay.lessons.map((l) => l.id) : [];
    if (
      !Array.isArray(mod.lessonIds) ||
      mod.lessonIds.length !== dayLessonIds.length ||
      !mod.lessonIds.every((id, idx) => id === dayLessonIds[idx])
    ) {
      errors.push(
        `Module ${mod.id} : les leçons référencées [${mod.lessonIds?.join(', ') ?? ''}] ne correspondent pas exactement aux leçons de sa journée [${dayLessonIds.join(', ')}].`
      );
    }
  }

  // Vérification de la répartition officielle 2 + 3 + 2
  const expectedDistribution: Record<1 | 2 | 3, number> = { 1: 2, 2: 3, 3: 2 };
  for (const day of days) {
    const expectedCount = expectedDistribution[day.dayNumber];
    if (expectedCount !== undefined && (!day.lessons || day.lessons.length !== expectedCount)) {
      errors.push(
        `Journée ${day.dayNumber} (${day.id}) : attendu exactement ${expectedCount} leçons (répartition 2+3+2), reçu ${day.lessons?.length ?? 0}.`
      );
    }
  }

  const seenLessonIds = new Set<string>();
  for (const day of days) {
    if ('steps' in (day as unknown as Record<string, unknown>)) {
      errors.push(`La journée ${day.id} ne doit pas posséder un tableau steps parallèle.`);
    }
    for (const lesson of day.lessons) {
      if (seenLessonIds.has(lesson.id)) {
        errors.push(`Identifiant de leçon dupliqué : ${lesson.id}`);
      }
      seenLessonIds.add(lesson.id);

      const expectedLessonIdFromNumber = `lesson-${String(lesson.lessonNumber).padStart(2, '0')}`;
      if (lesson.id !== expectedLessonIdFromNumber) {
        errors.push(
          `Discordance d'identifiant pour la leçon : ${lesson.id} ne correspond pas à son numéro ${lesson.lessonNumber} (attendu ${expectedLessonIdFromNumber}).`
        );
      }

      if (lesson.dayId !== day.id || lesson.dayNumber !== day.dayNumber) {
        errors.push(
          `Incohérence de rattachement journalier pour la leçon ${lesson.id} dans ${day.id}`
        );
      }
      if (lesson.moduleId !== day.moduleId) {
        errors.push(
          `Incohérence de rattachement modulaire pour la leçon ${lesson.id} dans ${day.id}`
        );
      }
    }
  }

  for (const expectedLessonId of ALL_LESSON_IDS) {
    if (!seenLessonIds.has(expectedLessonId)) {
      errors.push(`Identifiant officiel de leçon manquant : ${expectedLessonId}`);
    }
  }

  return {
    isValid: errors.length === 0,
    errors,
  };
}

/**
 * Lève une exception si l'intégrité du cursus est violée.
 */
export function assertCourseIntegrity(
  modules: readonly CourseModule[] = MAIN_COURSES,
  days: readonly Day[] = ALL_DAYS
): void {
  const result = validateCourseIntegrity(modules, days);
  if (!result.isValid) {
    throw new Error(
      `Violation de l'intégrité du cursus : ${result.errors.join(' ; ')}`
    );
  }
}

/**
 * Normalise rigoureusement une route active vers l'unique forme canonique :
 * - { kind: 'home' }
 * - { kind: 'lesson', lessonId: 'lesson-01'..'lesson-07' }
 * - { kind: 'bonus', bonusId: 'bonus-manychat' | 'bonus-marketing' }
 *
 * Toutes les anciennes routes ('resources', 'practical-sheets', 'start-here', 'course', 'day')
 * sont ramenées vers { kind: 'home' } sans réinterprétation arbitraire.
 */
export function normalizeActiveRoute(rawRoute: unknown): ActiveRoute {
  if (!rawRoute || typeof rawRoute !== 'object') {
    return { kind: 'home' };
  }

  const candidate = rawRoute as Record<string, unknown>;

  if (candidate.kind === 'home') {
    return { kind: 'home' };
  }

  if (candidate.kind === 'lesson') {
    const validLessonId = normalizeLessonId(candidate.lessonId);
    if (validLessonId) {
      return { kind: 'lesson', lessonId: validLessonId };
    }
    return { kind: 'home' };
  }

  if (candidate.kind === 'bonus') {
    const rawBonusId = typeof candidate.bonusId === 'string' ? candidate.bonusId.trim() : '';
    if (VALID_BONUS_IDS.has(rawBonusId)) {
      return { kind: 'bonus', bonusId: rawBonusId };
    }
    if (rawBonusId === 'bonus-01') {
      return { kind: 'bonus', bonusId: 'bonus-manychat' };
    }
    if (rawBonusId === 'bonus-03') {
      return { kind: 'bonus', bonusId: 'bonus-marketing' };
    }
    return { kind: 'home' };
  }

  // Anciennes routes supprimées ou issues de l'ancien cursus à 9 journées :
  // 'resources', 'practical-sheets', 'start-here', 'course', 'day' -> retour à l'accueil
  return { kind: 'home' };
}

/**
 * Résout la leçon active à partir de la route canonique.
 */
export function resolveActiveLesson(route: ActiveRoute): Lesson | null {
  if (route.kind === 'lesson') {
    return getLessonById(route.lessonId) ?? null;
  }
  return null;
}

/**
 * Résout la journée active à partir de la route canonique.
 */
export function resolveActiveDay(route: ActiveRoute): Day | null {
  const lesson = resolveActiveLesson(route);
  if (!lesson) return null;
  return getDayById(lesson.dayId) ?? null;
}

/**
 * Détermine l'identifiant du module actif à partir de la route courante.
 * Retourne null si l'utilisateur est sur l'accueil ou sur un bonus.
 */
export function resolveActiveCourseId(route: ActiveRoute): ModuleId | null {
  const lesson = resolveActiveLesson(route);
  if (lesson) {
    return lesson.moduleId;
  }
  return null;
}

/**
 * Filtre la liste des leçons pour n'extraire que celles appartenant au module demandé.
 */
export function getCourseLessons(
  allLessons: readonly Lesson[],
  courseId: string
): Lesson[] {
  const course = getCourseById(courseId);
  if (!course) {
    return [];
  }
  const allowedSet = new Set<string>(course.lessonIds);
  return allLessons.filter((l) => allowedSet.has(l.id));
}

export const getCourseDays = getCourseLessons;

/**
 * Filtre la liste des leçons pour n'extraire que celles appartenant à la journée demandée.
 */
export function getDayLessons(
  allLessons: readonly Lesson[],
  dayNumberOrId: number | string
): Lesson[] {
  if (typeof dayNumberOrId === 'number') {
    return allLessons.filter((l) => l.dayNumber === dayNumberOrId);
  }
  return allLessons.filter((l) => l.dayId === dayNumberOrId);
}

/**
 * Formate le titre de la plage de leçons pour la barre latérale du module.
 * Ex. : "LEÇONS 1 À 2", "LEÇONS 3 À 5", "LEÇONS 6 À 7"
 */
export function formatCourseLessonRangeTitle(
  lessonRange?: readonly [number, number]
): string {
  if (!lessonRange) {
    return 'LEÇONS';
  }
  return `LEÇONS ${lessonRange[0]} À ${lessonRange[1]}`;
}

export const formatCourseDayRangeTitle = formatCourseLessonRangeTitle;
</file>

<file path="src/utils/progressCalculator.ts">
import {
  ALL_STEP_TYPES,
  type CourseModule,
  type Day,
  type DayId,
  type Lesson,
  type LessonId,
  type ModuleId,
  type Step,
  type StepType,
} from '../types/course';
import { ALL_DAYS, ALL_LESSONS } from '../data/course';
import { COURSE_MODULES } from '../data/sprints';

export const TOTAL_COURSE_MODULES = 3;
export const TOTAL_COURSE_DAYS = 3;
export const TOTAL_COURSE_LESSONS = 7;

export interface LessonProgressResult {
  completedStepIds: string[];
  completedCount: number;
  totalSteps: number;
  total: number;
  percentage: number;
  isCompleted: boolean;
}

export type DailyProgressResult = LessonProgressResult;

export interface DayProgressResult {
  dayId: DayId;
  dayNumber: number;
  completedLessonIds: LessonId[];
  completedLessonsCount: number;
  totalLessons: number;
  percentage: number;
  isCompleted: boolean;
}

export interface ModuleProgressResult {
  moduleId: ModuleId;
  completedLessonIds: LessonId[];
  completedLessonsCount: number;
  totalLessons: number;
  completedDayIds: DayId[];
  completedDaysCount: number;
  totalDays: number;
  percentage: number;
  isCompleted: boolean;
}

export interface GlobalProgressResult {
  completedLessonIds: LessonId[];
  completedLessonNumbers: number[];
  completedLessonsCount: number;
  totalLessons: number;
  completedDayIds: DayId[];
  completedDayNumbers: number[];
  completedDaysCount: number;
  totalDays: number;
  completedModuleIds: ModuleId[];
  completedModulesCount: number;
  totalModules: number;
  percentage: number;
}

/**
 * Normalise les identifiants d'étapes terminées en supprimant les doublons
 * et les valeurs non textuelles ou vides.
 */
export function normalizeStepIdList(stepIds: readonly string[] | undefined): string[] {
  if (!Array.isArray(stepIds)) {
    return [];
  }
  const seen = new Set<string>();
  const normalized: string[] = [];
  for (const id of stepIds) {
    if (typeof id === 'string') {
      const trimmed = id.trim();
      if (trimmed.length > 0 && !seen.has(trimmed)) {
        seen.add(trimmed);
        normalized.push(trimmed);
      }
    }
  }
  return normalized;
}

/**
 * Fonction conservée pour l'archivage de migration des anciens formats V1.
 */
export function normalizeStepList(steps: readonly StepType[] | undefined): StepType[] {
  if (!Array.isArray(steps)) {
    return [];
  }
  const validSet = new Set<StepType>();
  for (const step of steps) {
    if (ALL_STEP_TYPES.includes(step)) {
      validSet.add(step);
    }
  }
  return ALL_STEP_TYPES.filter((step) => validSet.has(step));
}

function computeLessonProgressFromSteps(
  completedStepIds: readonly string[] | undefined,
  steps: readonly Step[]
): LessonProgressResult {
  const normalizedCompleted = normalizeStepIdList(completedStepIds);
  const validStepIds: string[] = [];
  const seenValid = new Set<string>();

  for (const step of steps) {
    if (step && typeof step.id === 'string') {
      const trimmed = step.id.trim();
      if (trimmed.length > 0 && !seenValid.has(trimmed)) {
        seenValid.add(trimmed);
        validStepIds.push(trimmed);
      }
    }
  }

  const total = validStepIds.length;
  if (total === 0) {
    return {
      completedStepIds: [],
      completedCount: 0,
      totalSteps: 0,
      total: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  const validCompleted = normalizedCompleted.filter((id) => seenValid.has(id));
  const completedCount = validCompleted.length;
  const percentage = Math.round((completedCount / total) * 100);

  return {
    completedStepIds: validCompleted,
    completedCount,
    totalSteps: total,
    total,
    percentage,
    isCompleted: completedCount === total,
  };
}

/**
 * Calcule la progression d'une leçon à partir de ses étapes réelles (ou d'un total d'étapes).
 * - Une leçon sans étape (total === 0) a toujours 0 % de progression et n'est jamais terminée.
 * - Seuls les identifiants appartenant réellement à cette leçon sont comptabilisés.
 */
export function calculateLessonProgress(
  lessonOrCompletedStepIds: Pick<Lesson, 'steps'> | readonly string[] | undefined,
  completedStepIdsOrSteps?: readonly string[] | readonly Step[] | number
): LessonProgressResult {
  // Appel sous la forme (lesson, completedStepIds)
  if (
    lessonOrCompletedStepIds &&
    !Array.isArray(lessonOrCompletedStepIds) &&
    typeof lessonOrCompletedStepIds === 'object' &&
    'steps' in lessonOrCompletedStepIds
  ) {
    const steps = Array.isArray(lessonOrCompletedStepIds.steps)
      ? lessonOrCompletedStepIds.steps
      : [];
    const completed = Array.isArray(completedStepIdsOrSteps)
      ? (completedStepIdsOrSteps as readonly string[])
      : undefined;
    return computeLessonProgressFromSteps(completed, steps);
  }

  // Appel sous la forme (completedStepIds, steps | totalSteps)
  const completedStepIds = Array.isArray(lessonOrCompletedStepIds)
    ? (lessonOrCompletedStepIds as readonly string[])
    : undefined;

  if (Array.isArray(completedStepIdsOrSteps)) {
    return computeLessonProgressFromSteps(
      completedStepIds,
      completedStepIdsOrSteps as readonly Step[]
    );
  }

  const normalizedCompleted = normalizeStepIdList(completedStepIds);
  const totalSteps =
    typeof completedStepIdsOrSteps === 'number' ? completedStepIdsOrSteps : 0;
  if (!Number.isInteger(totalSteps) || totalSteps <= 0) {
    return {
      completedStepIds: [],
      completedCount: 0,
      totalSteps: 0,
      total: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  const validCompleted = normalizedCompleted.slice(0, totalSteps);
  const completedCount = validCompleted.length;
  const percentage = Math.round((completedCount / totalSteps) * 100);

  return {
    completedStepIds: validCompleted,
    completedCount,
    totalSteps,
    total: totalSteps,
    percentage,
    isCompleted: completedCount >= totalSteps,
  };
}

/**
 * Détermine si une leçon est entièrement terminée.
 * Une leçon sans étape (0 étape) ne peut jamais être considérée comme terminée.
 */
export function isLessonCompleted(
  lessonOrCompletedStepIds: Pick<Lesson, 'steps'> | readonly string[] | undefined,
  completedStepIdsOrSteps?: readonly string[] | readonly Step[] | number
): boolean {
  return calculateLessonProgress(lessonOrCompletedStepIds, completedStepIdsOrSteps).isCompleted;
}

export const calculateDailyProgress = calculateLessonProgress;
export const isDayCompleted = isLessonCompleted;

/**
 * Dérive la progression d'une journée exclusivement à partir des leçons qui lui appartiennent.
 * - Une leçon terminée est comptabilisée une seule fois.
 * - Une journée est terminée uniquement lorsque toutes ses leçons sont terminées.
 * - Une journée sans leçon retourne 0 % et false sans division par zéro.
 */
export function calculateDayProgress(
  day: Pick<Day, 'id' | 'dayNumber' | 'lessons'> | undefined,
  completedStepIdsByLesson: Readonly<Partial<Record<string, readonly string[]>>> | undefined
): DayProgressResult {
  if (!day || !Array.isArray(day.lessons) || day.lessons.length === 0) {
    return {
      dayId: day?.id ?? 'day-01',
      dayNumber: day?.dayNumber ?? 1,
      completedLessonIds: [],
      completedLessonsCount: 0,
      totalLessons: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  const safeMap =
    completedStepIdsByLesson && typeof completedStepIdsByLesson === 'object'
      ? completedStepIdsByLesson
      : {};

  const uniqueLessons: Lesson[] = [];
  const seenLessonIds = new Set<LessonId>();
  for (const lesson of day.lessons) {
    if (lesson && lesson.id && !seenLessonIds.has(lesson.id)) {
      seenLessonIds.add(lesson.id);
      uniqueLessons.push(lesson);
    }
  }

  const totalLessons = uniqueLessons.length;
  if (totalLessons === 0) {
    return {
      dayId: day.id,
      dayNumber: day.dayNumber,
      completedLessonIds: [],
      completedLessonsCount: 0,
      totalLessons: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  const completedLessonIds: LessonId[] = [];
  for (const lesson of uniqueLessons) {
    const stepsForLesson = safeMap[lesson.id];
    if (isLessonCompleted(lesson, stepsForLesson)) {
      completedLessonIds.push(lesson.id);
    }
  }

  const completedLessonsCount = completedLessonIds.length;
  const percentage = Math.round((completedLessonsCount / totalLessons) * 100);

  return {
    dayId: day.id,
    dayNumber: day.dayNumber,
    completedLessonIds,
    completedLessonsCount,
    totalLessons,
    percentage,
    isCompleted: completedLessonsCount === totalLessons,
  };
}

/**
 * Dérive la progression d'un module à partir de ses journées et de leurs leçons.
 * - Un module est terminé uniquement lorsque toutes ses leçons sont terminées.
 * - Un module sans leçon retourne 0 % et false sans division par zéro.
 */
export function calculateModuleProgress(
  moduleItem: Pick<CourseModule, 'id' | 'dayId' | 'lessonIds'> | undefined,
  daysOrCompletedMap:
    | readonly Day[]
    | Readonly<Partial<Record<string, readonly string[]>>>
    | undefined,
  completedMapOrLessons?:
    | Readonly<Partial<Record<string, readonly string[]>>>
    | readonly Lesson[]
): ModuleProgressResult {
  if (!moduleItem) {
    return {
      moduleId: 'module-01',
      completedLessonIds: [],
      completedLessonsCount: 0,
      totalLessons: 0,
      completedDayIds: [],
      completedDaysCount: 0,
      totalDays: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  let days: readonly Day[] = ALL_DAYS;
  let completedStepIdsByLesson: Readonly<Partial<Record<string, readonly string[]>>> = {};
  let explicitLessons: readonly Lesson[] | null = null;

  if (Array.isArray(daysOrCompletedMap)) {
    days = daysOrCompletedMap as readonly Day[];
    if (
      completedMapOrLessons &&
      !Array.isArray(completedMapOrLessons) &&
      typeof completedMapOrLessons === 'object'
    ) {
      completedStepIdsByLesson = completedMapOrLessons as Readonly<
        Partial<Record<string, readonly string[]>>
      >;
    }
  } else {
    if (daysOrCompletedMap && typeof daysOrCompletedMap === 'object') {
      completedStepIdsByLesson = daysOrCompletedMap as Readonly<
        Partial<Record<string, readonly string[]>>
      >;
    }
    if (Array.isArray(completedMapOrLessons)) {
      explicitLessons = completedMapOrLessons as readonly Lesson[];
    }
  }

  const allowedLessonIds = new Set<string>(moduleItem.lessonIds ?? []);
  if (allowedLessonIds.size === 0) {
    return {
      moduleId: moduleItem.id,
      completedLessonIds: [],
      completedLessonsCount: 0,
      totalLessons: 0,
      completedDayIds: [],
      completedDaysCount: 0,
      totalDays: 0,
      percentage: 0,
      isCompleted: false,
    };
  }

  const uniqueLessons: Lesson[] = [];
  const seenLessonIds = new Set<LessonId>();
  const completedDayIds: DayId[] = [];
  let totalDays = 0;

  if (explicitLessons) {
    totalDays = 1;
    for (const lesson of explicitLessons) {
      if (
        lesson &&
        lesson.id &&
        allowedLessonIds.has(lesson.id) &&
        !seenLessonIds.has(lesson.id)
      ) {
        seenLessonIds.add(lesson.id);
        uniqueLessons.push(lesson);
      }
    }
  } else {
    const moduleDays = days.filter(
      (d) => d.moduleId === moduleItem.id || d.id === moduleItem.dayId
    );
    totalDays = moduleDays.length;
    for (const day of moduleDays) {
      const dayResult = calculateDayProgress(day, completedStepIdsByLesson);
      if (dayResult.isCompleted) {
        completedDayIds.push(day.id);
      }
      for (const lesson of day.lessons) {
        if (
          lesson &&
          lesson.id &&
          allowedLessonIds.has(lesson.id) &&
          !seenLessonIds.has(lesson.id)
        ) {
          seenLessonIds.add(lesson.id);
          uniqueLessons.push(lesson);
        }
      }
    }
  }

  const totalLessons = uniqueLessons.length;
  if (totalLessons === 0) {
    return {
      moduleId: moduleItem.id,
      completedLessonIds: [],
      completedLessonsCount: 0,
      totalLessons: 0,
      completedDayIds: [],
      completedDaysCount: 0,
      totalDays,
      percentage: 0,
      isCompleted: false,
    };
  }

  const completedLessonIds: LessonId[] = [];
  for (const lesson of uniqueLessons) {
    if (isLessonCompleted(lesson, completedStepIdsByLesson[lesson.id])) {
      completedLessonIds.push(lesson.id);
    }
  }

  const completedLessonsCount = completedLessonIds.length;
  const percentage = Math.round((completedLessonsCount / totalLessons) * 100);
  if (explicitLessons && completedLessonsCount === totalLessons) {
    completedDayIds.push(moduleItem.dayId);
  }

  return {
    moduleId: moduleItem.id,
    completedLessonIds,
    completedLessonsCount,
    totalLessons,
    completedDayIds,
    completedDaysCount: completedDayIds.length,
    totalDays,
    percentage,
    isCompleted: completedLessonsCount === totalLessons,
  };
}

/**
 * Calcule la progression globale sur les 7 leçons du cursus et dérive
 * l'état de complétion des 3 journées et des 3 modules.
 */
export function calculateGlobalProgress(
  completedStepIdsByLesson: Readonly<Partial<Record<string, readonly string[]>>> | undefined,
  daysOrLessons: readonly Day[] | readonly Lesson[] = ALL_DAYS,
  modulesOrDays: readonly CourseModule[] | readonly Day[] = COURSE_MODULES
): GlobalProgressResult {
  const safeMap =
    completedStepIdsByLesson && typeof completedStepIdsByLesson === 'object'
      ? completedStepIdsByLesson
      : {};

  let lessonsSource: readonly Lesson[] = ALL_LESSONS;
  let daysSource: readonly Day[] = ALL_DAYS;
  let modulesSource: readonly CourseModule[] = COURSE_MODULES;

  if (Array.isArray(daysOrLessons) && daysOrLessons.length > 0) {
    const first = daysOrLessons[0];
    if ('lessons' in first) {
      daysSource = daysOrLessons as readonly Day[];
      lessonsSource = daysSource.flatMap((d) => d.lessons);
    } else if ('steps' in first) {
      lessonsSource = daysOrLessons as readonly Lesson[];
    }
  } else if (Array.isArray(daysOrLessons) && daysOrLessons.length === 0) {
    lessonsSource = [];
    daysSource = [];
  }

  if (Array.isArray(modulesOrDays) && modulesOrDays.length > 0) {
    const first = modulesOrDays[0];
    if ('lessons' in first) {
      daysSource = modulesOrDays as readonly Day[];
    } else if ('moduleNumber' in first) {
      modulesSource = modulesOrDays as readonly CourseModule[];
    }
  }

  const uniqueLessons: Lesson[] = [];
  const seenLessonIds = new Set<LessonId>();

  for (const lesson of lessonsSource) {
    if (lesson && lesson.id && !seenLessonIds.has(lesson.id)) {
      seenLessonIds.add(lesson.id);
      uniqueLessons.push(lesson);
    }
  }

  const totalLessons = uniqueLessons.length;
  const completedLessonIds: LessonId[] = [];
  const completedLessonNumbers: number[] = [];

  for (const lesson of uniqueLessons) {
    if (isLessonCompleted(lesson, safeMap[lesson.id])) {
      completedLessonIds.push(lesson.id);
      completedLessonNumbers.push(lesson.lessonNumber);
    }
  }

  const completedDayIds: DayId[] = [];
  const completedDayNumbers: number[] = [];
  for (const day of daysSource) {
    const dayProg = calculateDayProgress(day, safeMap);
    if (dayProg.isCompleted) {
      completedDayIds.push(day.id);
      completedDayNumbers.push(day.dayNumber);
    }
  }

  const completedModuleIds: ModuleId[] = [];
  for (const mod of modulesSource) {
    const modProg = calculateModuleProgress(mod, daysSource, safeMap);
    if (modProg.isCompleted) {
      completedModuleIds.push(mod.id);
    }
  }

  const completedLessonsCount = completedLessonIds.length;
  const percentage =
    totalLessons > 0 ? Math.round((completedLessonsCount / totalLessons) * 100) : 0;

  return {
    completedLessonIds,
    completedLessonNumbers,
    completedLessonsCount,
    totalLessons,
    completedDayIds,
    completedDayNumbers,
    completedDaysCount: completedDayIds.length,
    totalDays: TOTAL_COURSE_DAYS,
    completedModuleIds,
    completedModulesCount: completedModuleIds.length,
    totalModules: TOTAL_COURSE_MODULES,
    percentage,
  };
}
</file>

