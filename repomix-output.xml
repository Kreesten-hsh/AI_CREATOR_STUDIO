  // =========================================================================
  // 9. Étape 2 : Action de copie du prompt
  // =========================================================================
  it('9. permet de copier le prompt compilé dans le presse-papier sans régression', async () => {
    const writeTextMock = vi.fn().mockResolvedValue(undefined);
    Object.assign(navigator, {
      clipboard: {
