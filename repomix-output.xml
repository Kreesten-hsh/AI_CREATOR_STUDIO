  // =========================================================================
  // 6. Étape 1 : Interaction Quiz & Calcul de Score
  // =========================================================================
  it('6. permet d\'interagir avec le quiz, affiche les explications et le score de réussite', () => {
    setupWorkspaceForDay(2, 'concept');
    render(
      <ProgressProvider>
        <CourseWorkspaceRouter />
