    expect(day02.steps[1].id).toBe('day-02-step-2');
    expect(day02.steps[1].legacyType).toBe('prompt');
    expect(day02.steps[1].title).toBe('Prompt Claude');

    expect(day02.steps[2].id).toBe('day-02-step-3');
