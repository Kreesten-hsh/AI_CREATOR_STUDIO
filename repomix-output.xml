            <tr>
              <td>Formateur / Infopreneur</td>
              <td>15 à 20 h / sem</td>
              <td>6 à 8 h / sem</td>
              <td>1 contenu long + 4 micro-formats</td>
            </tr>
            <tr>
              <td>Coach / Consultant</td>
              <td>20 à 25 h / sem</td>
              <td>4 à 5 h / sem</td>
              <td>2 études de cas + 2 relances DM</td>
            </tr>
          </tbody>
        </table>

        <p style="font-size: 12px; color: #777777; font-style: italic;">
