export function isFontAvailable(fontName: string): boolean {
  if (typeof document === 'undefined' || !document.fonts?.check) {
    return true;
  }
  try {
    return document.fonts.check(`16px "${fontName}"`);
  } catch {
    return false;
  }
}

export function VibePicker({ block }: { block?: VibePickerBlock }) {
