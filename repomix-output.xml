    setupWorkspaceForDay(2, 'prompt');
    render(
      <ProgressProvider>
        <CourseWorkspaceRouter />
      </ProgressProvider>
    );

    const copyBtn = screen.getByRole('button', { name: /Copier le prompt/i });
    await act(async () => {
      fireEvent.click(copyBtn);
